	<Frame name="zBagB" parent="UIParent" hidden="true" enableMouse="true" frameStrata="LOW">
		<Size> <AbsDimension x="10" y="10"/></Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset><AbsDimension x="50" y="200"/></Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Frame name="zBagBBackground" inherits="UIPanelBackdropFrame" enableMouse="true" frameStrata="LOW">
				<Size><AbsDimension x="250" y="250"/></Size>
				<Anchors><Anchor point="TOPLEFT">
						<Offset><AbsDimension x="-14" y="-16"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="zBagBTitleText" inherits="GameTitleFont" text="zBank">
							<Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="14" y="7"/></Offset></Anchor></Anchors>
						</FontString>
					</Layer>
					<Layer level="ARTWORK">
						<FontString name="zBagBInspect" inherits="GameTitleFont" text="PREVIEW">
							<Color r="0.7" g="0" b="0" a="1"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="zBagBTitleText" relativePoint="TOPRIGHT">					
									<Offset><AbsDimension x="0" y="0"/></Offset>
								</Anchor>
							</Anchors>							
						</FontString>
					</Layer>
				</Layers>				
				<Scripts><OnLoad>UIPanelBackdropFrame_SetTexture(this,"Interface/Common/PanelCommonBorder",64,64);</OnLoad>
				<OnMouseDown>
				--this code makes sure you only move the bag when grabbing any of the 15 pixels on the edge of the frame
				local frameX, frameY	= this:GetPos(); --get top left corner of bag frame
				local frameW, frameH	= this:GetSize();  --get size of frame
				
				--allow grabbing from 15 pixels on any edge
				local leftXGrabMin, leftXGrabMax, topYGrabMin, topYGrabMax, rightXGrabMin, rightXGrabMax, bottomYGrabMin, bottomYGrabMax;
				leftXGrabMin = frameX;
				leftXGrabMax = leftXGrabMin+15;
				topYGrabMin = frameY;
				topYGrabMax = topYGrabMin + 15;
				rightXGrabMax = leftXGrabMin + frameW;
				rightXGrabMin = rightXGrabMax - 15;
				bottomYGrabMax = topYGrabMin + frameH;
				bottomYGrabMin = bottomYGrabMax -15;
				
				-- get mouse position
				local cursorX, cursorY = GetCursorPos();
				
				--figure out if your cursor is on an edge
				local withinPixelsFromTop, withinPixelsFromLeft, withinPixelsFromRight, withinPixelsFromBottom;
				withinPixelsFromTop = math.max(topYGrabMax - cursorY, 0);
				withinPixelsFromLeft = math.max(leftXGrabMax - cursorX, 0);
				withinPixelsFromRight = math.max(cursorX - rightXGrabMin, 0);
				withinPixelsFromBottom = math.max(cursorY - bottomYGrabMin, 0);
				
				if ((withinPixelsFromTop ==0) and (withinPixelsFromLeft ==0) and (withinPixelsFromRight ==0) and (withinPixelsFromBottom ==0)) then
					--if your cursor is in the middle, do nothing
				else
					--if your cursor is on an edge
					if IsShiftKeyDown() then
						zBagB:SetFrameStrata( "MEDIUM" );
					else
						zBagB:SetFrameStrata( "LOW" );
					end
					this:StartMoving("TOPLEFT");
				end
				</OnMouseDown>
				<OnMouseUp>
				this:StopMovingOrSizing();
				local xx,yy = zBagB:GetPos();
				zBag_VAR["bbx"],zBag_VAR["bby"] = zBagBBackground:GetPos();
				zBag_VAR["bbx"] = zBag_VAR["bbx"] - xx;
				zBag_VAR["bby"] = zBag_VAR["bby"] - yy;
				this:ClearAllAnchors();
				this:SetAnchor("TOPLEFT","TOPLEFT","zBagB",zBag_VAR["bbx"]/GetUIScale(),zBag_VAR["bby"]/GetUIScale());
				SaveVariablesPerCharacter("zBag_VAR");
				SaveVariables("zBag_VAR");
				</OnMouseUp>
				</Scripts>
			</Frame>
			<Button name="zBagBBackgroundCloseButton"  inherits="UIPanelCloseButtonTemplate"> <!-- override default close button -->
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="zBagBBackground" relativePoint="TOPRIGHT">					
