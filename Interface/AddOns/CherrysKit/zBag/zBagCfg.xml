									</Anchors>
								</FontString>
								<FontString inherits="GameFontHighlight" name="$parentTxt3"> <!-- 1.5 -->
									<Anchors>
										<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<ThumbTexture file="Interface\BagFrame\BagFrame-Slider-Knob">
							<Size>
								<AbsDimension x="16" y="16"/>
							</Size>
						</ThumbTexture>
						<Scripts>
							<OnShow>
							this.loading=1;
							this:SetValueStepMode("FLOAT");
							this:SetMinMaxValues(0.5,1.5);
							this.loading=0;
							this:SetValue(ZBAG_SCALE);
							</OnShow>
							<OnValueChanged>
							if (this:IsVisible() and this.loading and this.loading==0) then
								ZBAG_SCALE=zBagScaleSlider:GetValue();
								zBag_Resize(this);
								zBag_Update();
							end
							</OnValueChanged>
						</Scripts>
					</Slider>
