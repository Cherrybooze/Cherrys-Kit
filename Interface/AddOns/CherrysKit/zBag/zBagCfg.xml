			<Slider name="zBagRowSlider" orientation="HORIZONTAL">
						<Size><AbsDimension x="150" y="10"/></Size>
						<Anchors>
							<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentTxt1">
								<Offset><AbsDimension x="10" y="44"/></Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer>
								<Texture file="Interface\BagFrame\BagFrame-Slider-Border"/>
							</Layer>
							<Layer level="ARTWORK">
								<FontString inherits="GameFontHighlight" name="$parentTxt1" > <!-- "Number of items on a row" -->
									<Anchors>
										<Anchor point="BOTTOM" relativePoint="TOP">
											<Offset>
												<AbsDimension x="0" y="-4"/>
											</Offset>
										</Anchor>
									</Anchors>
								</FontString>
								<FontString inherits="GameFontHighlight" name="$parentTxt2"> <!-- 2 -->
									<Anchors>
										<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT"/>
									</Anchors>
								</FontString>
								<FontString inherits="GameFontHighlight" name="$parentTxt3"> <!-- 20 -->
									<Anchors>
										<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<ThumbTexture file="Interface\BagFrame\BagFrame-Slider-Knob">
							<Size>
								<AbsDimension x="16" y="16"/>
							</Size>
						</ThumbTexture>
						<Scripts>
							<OnShow>
							this.loading=1;
							this:SetValueStepMode("INT");
							this:SetMinMaxValues(2,20);
							this.loading=0;
							this:SetValue(ZBAG_ROW_ITEMS);
							</OnShow>
							<OnValueChanged>
							if (this:IsVisible() and this.loading and this.loading==0) then
								ZBAG_ROW_ITEMS=zBagRowSlider:GetValue();
								zBag_Resize(this);
								zBag_Update();
							end
							</OnValueChanged>
						</Scripts>
					</Slider>
			<Slider name="zBagScaleSlider" orientation="HORIZONTAL">
						<Size><AbsDimension x="150" y="10"/></Size>
						<Anchors>
