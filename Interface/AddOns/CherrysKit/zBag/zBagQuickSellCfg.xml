	<!--Quick Sell Config Frame -->
	
	<Frame name="zBagQuickSellConfigFrame" parent="UIParent" inherits="UICommonFrameTemplate" enableMouse="true" frameStrata="MEDIUM" hidden="true">
		<Size><AbsDimension x="550" y="320"/></Size>
		<Anchors><Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="zBagQuickSellConfigTitleText" inherits="GameTitleFont"> <!-- "zBag Quick Sell Configuration" -->
					<Anchors><Anchor point="TOP"><Offset><AbsDimension x="-24" y="7"/></Offset></Anchor></Anchors>
				</FontString>
				<FontString name="zBagVersionText" inherits="GameFontHighlight" justifyH="RIGHT">
					<Size>
						<AbsDimension x="178" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMRIGHT">
							<Offset><AbsDimension x="-40" y="-2"/></Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
<!-- zBag Quick Sell Left Column Configuration Text -->
			<Layer level="OVERLAY">
				<FontString name="$parentTxt1" inherits="GameFontLabelYellow"> <!-- "Options:" -->
					<Anchors><Anchor point="TOPLEFT">
					<Offset><AbsDimension x="15" y="35"/></Offset>
					</Anchor></Anchors>
				</FontString>				
			</Layer>
<!-- zBag Quick Sell Right Column Configuration Text -->
			<Layer level="OVERLAY">
				<FontString name="$parentTxt2" inherits="GameFontLabelYellow"> <!-- "Don't sell if:" -->
					<Anchors><Anchor point="TOPLEFT">
					<Offset><AbsDimension x="295" y="35"/></Offset>
					</Anchor></Anchors>
				</FontString>				
			</Layer>
		</Layers>
		<Frames>
<!-- Left side options -->
		<EditBox name="$parentquicksellstartslotnumber" inherits="UIPanelEditBoxTemplate" letters="3" numeric="true">
			<Size><AbsDimension x="32" y="22"/></Size>
			<Anchors><Anchor point="TOPLEFT" relativeTo="$parentTxt1" relativePoint="BOTTOMLEFT">
				<Offset><AbsDimension x="0" y="1"/></Offset>
			</Anchor></Anchors>
			<HitRectInsets>
				<AbsInset top="0" left="8" bottom="8" right="0"/>
			</HitRectInsets>
			<Layers>
				<Layer level="OVERLAY">
					<FontString name="$parentTxt1" inherits="GameFontLabelYellow"> <!-- "Quick sell start slot" -->
						<Anchors><Anchor point="TOPLEFT">
						<Offset><AbsDimension x="35" y="6"/></Offset>
						</Anchor></Anchors>
					</FontString>				
				</Layer>
			</Layers>
			<Scripts>
				<OnEnter>				
					GameTooltip:SetOwner(this, "ANCHOR_LEFT", 4, 0);
					GameTooltip:SetText("Quick sell start slot", 1, 1, 1);
					GameTooltip:AddLine("First bag slot to sell when you click the quick sell button.  To enable, enter a number between 1 and 180.  0 means no effect.", 0, 0.75, 0.95);
					GameTooltip:Show();
					zBagQuickSellConfig_showBagSlotNumbers();
				</OnEnter>
				<OnLeave>
					GameTooltip:Hide();
					zBagQuickSellConfig_hideBagSlotNumbers();
				</OnLeave>		
				<OnTextChanged>
					zBagQuickSellConfig_Save();
				</OnTextChanged>					
			</Scripts>
			<FontString inherits="GameEditFont"/>
		</EditBox>	
		<EditBox name="$parentquicksellendslotnumber" inherits="UIPanelEditBoxTemplate" letters="3" numeric="true">
			<Size><AbsDimension x="32" y="22"/></Size>
			<Anchors><Anchor point="TOPLEFT" relativeTo="$parentTxt1" relativePoint="BOTTOMLEFT">
				<Offset><AbsDimension x="0" y="20"/></Offset>
			</Anchor></Anchors>
			<HitRectInsets>
				<AbsInset top="0" left="8" bottom="8" right="0"/>
			</HitRectInsets>
			<Layers>
				<Layer level="OVERLAY">
					<FontString name="$parentTxt1" inherits="GameFontLabelYellow"> <!-- "Quick sell end slot" -->
						<Anchors><Anchor point="TOPLEFT">
						<Offset><AbsDimension x="35" y="6"/></Offset>
						</Anchor></Anchors>
					</FontString>				
				</Layer>
			</Layers>
			<Scripts>
				<OnEnter>				
					GameTooltip:SetOwner(this, "ANCHOR_LEFT", 4, 0);
					GameTooltip:SetText("Quick sell end slot", 1, 1, 1);
					GameTooltip:AddLine("Last backpack item to sell when you push the quick sell button.  To enable, enter a number between 1 and 180.  0 means no effect.", 0, 0.75, 0.95);
					GameTooltip:Show();
					zBagQuickSellConfig_showBagSlotNumbers();
				</OnEnter>
				<OnLeave>
					GameTooltip:Hide();
					zBagQuickSellConfig_hideBagSlotNumbers();
				</OnLeave>		
				<OnTextChanged>
					zBagQuickSellConfig_Save();
				</OnTextChanged>					
			</Scripts>
			<FontString inherits="GameEditFont"/>
		</EditBox>		
		<CheckButton name="$parentquickSellIgnoreOptions">
