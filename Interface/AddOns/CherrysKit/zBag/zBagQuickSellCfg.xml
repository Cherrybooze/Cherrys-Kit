						</Anchor></Anchors>
					</FontString>				
				</Layer>
			</Layers>
			<NormalTexture file="Interface\Buttons\CheckBox-Normal2"/>
			<PushedTexture file="Interface\Buttons\CheckBox-Depress2"/>
			<HighlightTexture file="Interface\Buttons\CheckBox-Highlight" alphaMode="ADD"/>
			<CheckedTexture file="Interface\Buttons\CheckBox-Checked"/>
			<DisabledCheckedTexture file="Interface\Buttons\CheckBox-Checked-Disabled"/>
			<Scripts>
				<OnClick>zBagQuickSellConfig_Save();</OnClick>
				<OnEnter>				
					GameTooltip:SetOwner(this, "ANCHOR_LEFT", 4, 0);
					GameTooltip:SetText("Ignore Don't Sell Options", 1, 1, 1);
					GameTooltip:AddLine("Enables very quick sell by selling ALL items within your quick sell start and end slot.  This option overrides the options on the right of this config window.", 0, 0.75, 0.95);
					GameTooltip:Show();
				</OnEnter>
				<OnLeave>
					GameTooltip:Hide();
				</OnLeave>
			</Scripts>
		</CheckButton>			
