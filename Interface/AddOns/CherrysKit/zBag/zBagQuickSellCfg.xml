	<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ zBagQSItemFilter ~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

	<Frame name="QSItemFilterFrame" inherits="UIPanelBackdropFrame" enableMouse="true" hidden="true" frameStrata="HIGH" parent="UIParent">
		<Size><AbsDimension x="500" y="500"/></Size>
		<Scripts>
			<OnMouseDown>QSItemFilterFrame:StartMoving("CENTER");</OnMouseDown>
			<OnMouseUp>QSItemFilterFrame:StopMovingOrSizing();</OnMouseUp>
		</Scripts>
		<Layers>
			<Layer>
				<Texture name="$parent_Image" file="Interface/AddOns/CherrysKit/zBag/Textures/minimap-normal.tga">
					<Size><AbsDimension x="64" y="64"/></Size>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
							<Offset><AbsDimension x="-20" y="-20"/></Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parent_Header" justifyH="CENTER" justifyV="MIDDLE" inherits="Font_Normal">
					<FontHeight><AbsValue val="16"/></FontHeight>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
							<Offset><AbsDimension x="0" y="0"/></Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
							<Offset><AbsDimension x="0" y="26"/></Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<ResizeBounds>
			<minResize><AbsDimension x="400" y="300"/></minResize>
			<maxResize><AbsDimension x="800" y="800"/></maxResize>
		</ResizeBounds>
		<Frames>
			<Button name="$parent_CloseButton" inherits="UIPanelCloseButtonTemplate">
				<Size><AbsDimension x="24" y="24"/></Size>
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
						<Offset><AbsDimension x="-1" y="1" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts><OnClick>HideUIPanel(QSItemFilterFrame); QSItemFilterFrame_Itemname:ClearFocus();</OnClick></Scripts>
			</Button>
			<Frame name="$parent_ResizeButton" enableMouse="true">
				<Size><AbsDimension x="16" y="16"/></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="-3" y="-3" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer>
						<Texture name="$parent_Image" file="Interface/AddOns/CherrysKit/zBag/Textures/resize.tga">
							<Size><AbsDimension x="16" y="16"/></Size>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnMouseDown>
						QSItemFilterFrame:StartSizing("BOTTOMRIGHT");
						QSData.Resizing = true;
					</OnMouseDown>
					<OnMouseUp>
						QSItemFilterFrame:StopMovingOrSizing();
						QSData.Resizing = false;
						QSItemFilterX,QSItemFilterY = QSItemFilterFrame:GetSize();
					</OnMouseUp>
					<OnEnter>SetHyperlinkCursor(true);  QSTooltip(this);</OnEnter>
					<OnLeave>SetHyperlinkCursor(false); GameTooltip:Hide();</OnLeave>
				</Scripts>
			</Frame>

			<Button name="$parent_ItemAdd" inherits="UIPlusButtonTemplate" enableMouse="true">
				<Size><AbsDimension x="20" y="20"/></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parent" relativePoint="TOPLEFT">
