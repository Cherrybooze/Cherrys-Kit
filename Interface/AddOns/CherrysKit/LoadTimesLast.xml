<Ui xmlns="http://www.runewaker.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/UI.xsd">
	<!-- Load-time probe (see LoadTimes/CherrysLoadTimes.lua). build_kit.py loads this file after every addon. -->
	<Frame name="CherrysKit_LoadLast" parent="UIParent">
		<Size><AbsDimension x="1" y="1" /></Size>
		<Anchors><Anchor point="TOPLEFT" relativeTo="UIParent" relativePoint="TOPLEFT" /></Anchors>
		<Scripts>
			<OnLoad>this:RegisterEvent("VARIABLES_LOADED"); this:RegisterEvent("LOADING_END");</OnLoad>
			<OnEvent>CherrysKit_Load.Event("last", event);</OnEvent>
			<OnUpdate>CherrysKit_Load.Update(this);</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
