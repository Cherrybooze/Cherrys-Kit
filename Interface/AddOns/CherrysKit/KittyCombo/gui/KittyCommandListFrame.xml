							<Anchors>
								<Anchor point="TOPLEFT" />
								<Anchor point="BOTTOMRIGHT" />
							</Anchors>
						</Texture>
						<Texture name="$parent_Highlight" file="Interface/Login/Common/ServerlistButton-Highlight" hidden="true" />
					</Layer>
					<Layer level="ARTWORK">
						<!-- Column headers -->
						<FontString name="KittyCommandListFrame_CommandListNameLabel" inherits="GameFontNormal" justifyH="LEFT" text="CommandListNameLabel">
							<Size><AbsDimension x="150" y="20" /></Size>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
									<Offset><AbsDimension x="12" y="6" /></Offset>
								</Anchor>
							</Anchors>
							<FontHeight><AbsValue val="13" /></FontHeight>
						</FontString>
						<FontString name="KittyCommandListFrame_CommandListClassLabel" inherits="GameFontNormal" justifyH="LEFT" text="CommandListClassLabel">
							<Size><AbsDimension x="90" y="20" /></Size>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
									<Offset><AbsDimension x="168" y="6" /></Offset>
								</Anchor>
							</Anchors>
							<FontHeight><AbsValue val="13" /></FontHeight>
						</FontString>
						<FontString name="KittyCommandListFrame_CommandListTargetLabel" inherits="GameFontNormal" justifyH="LEFT" text="CommandListTargetLabel">
							<Size><AbsDimension x="70" y="20" /></Size>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
									<Offset><AbsDimension x="266" y="6" /></Offset>
								</Anchor>
							</Anchors>
							<FontHeight><AbsValue val="13" /></FontHeight>
						</FontString>
						<FontString name="KittyCommandListFrame_ActionsLabel" inherits="GameFontNormal" justifyH="LEFT" text="">
							<Size><AbsDimension x="100" y="20" /></Size>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
									<Offset><AbsDimension x="340" y="6" /></Offset>
								</Anchor>
							</Anchors>
							<FontHeight><AbsValue val="13" /></FontHeight>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="KittyCommandListFrame_Button1"  inherits="KittyCommandListDetailTemplate" id="1" />
					<Button name="KittyCommandListFrame_Button2"  inherits="KittyCommandListDetailTemplate" id="2" />
					<Button name="KittyCommandListFrame_Button3"  inherits="KittyCommandListDetailTemplate" id="3" />
					<Button name="KittyCommandListFrame_Button4"  inherits="KittyCommandListDetailTemplate" id="4" />
					<Button name="KittyCommandListFrame_Button5"  inherits="KittyCommandListDetailTemplate" id="5" />
					<Button name="KittyCommandListFrame_Button6"  inherits="KittyCommandListDetailTemplate" id="6" />
					<Button name="KittyCommandListFrame_Button7"  inherits="KittyCommandListDetailTemplate" id="7" />
					<Button name="KittyCommandListFrame_Button8"  inherits="KittyCommandListDetailTemplate" id="8" />
					<Button name="KittyCommandListFrame_Button9"  inherits="KittyCommandListDetailTemplate" id="9" />
					<Button name="KittyCommandListFrame_Button10" inherits="KittyCommandListDetailTemplate" id="10" />
				</Frames>
				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Position the rows in the list, under the column headers
							for index=1, 10 do
								getglobal("KittyCommandListFrame_Button" .. index):ClearAllAnchors();
								getglobal("KittyCommandListFrame_Button" .. index):SetAnchor("TOPLEFT", "TOPLEFT", "KittyCommandListFrame_List", 0, (index-1)*37 + 30);
								getglobal("KittyCommandListFrame_Button" .. index):SetAnchor("BOTTOMRIGHT", "TOPRIGHT", "KittyCommandListFrame_List", 0, index*37 + 30);
							end;
						end)();
						]]>
					</OnLoad>
					<OnShow>
					</OnShow>
				</Scripts>
			</Frame>
			<!-- Slider -->
			<Slider name="KittyCommandListFrame_ScrollBar" inherits="KittyCommandListSliderTemplate">
				<Size><AbsDimension x="10" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="KittyCommandListFrame_List" relativePoint="TOPRIGHT">
						<Offset><AbsDimension x="10" y="20" /></Offset>
					</Anchor>
					<Anchor point="BOTTOMLEFT" relativeTo="KittyCommandListFrame_List" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="10" y="-20" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							this:SetValueStepMode("INT");
							this:SetMinMaxValues(1, 1);
						end)();
						]]>
					</OnLoad>
					<OnValueChanged>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandListFrame.onShowList(KittyCommandListFrame_ScrollBar, tonumber(this:GetValue()), 10);
						end)();
						]]>
					</OnValueChanged>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							if(delta > 0) then
								this:SetValue(this:GetValue() - 1);
							elseif(delta < 0) then
								this:SetValue(this:GetValue() + 1);
							end
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Slider>

			<!-- Button (save and close) -->
			<Button name="KittyCommandListFrame_CloseButton" inherits="UIPanelButtonTemplate" text="CloseButton">
				<Size><AbsDimension x="130" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="-140" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandListFrame.save();
							Kitty.CommandListFrame.close();
							KittyBasicConfigFrame:Show();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>

			<!-- Button (cancel) -->
			<Button name="KittyCommandListFrame_CancelButton" inherits="UIPanelButtonTemplate" text="CancelButton">
				<Size><AbsDimension x="110" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset><AbsDimension x="-22" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandListFrame.close();
							KittyBasicConfigFrame:Show();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>
		</Frames>

		<!-- Scripts -->
		<Scripts>
			<OnShow>
				<![CDATA[
				Kitty.protectFunction(function()
					Kitty.Skin.onShow(this);
				end)();
				]]>
			</OnShow>
			<OnHide>
			</OnHide>
			<OnMouseDown>
				<![CDATA[
				Kitty.protectFunction(function()
					-- A click on the window closes an open KittyCombo menu
					CloseDropDownMenus();
					if(key=="LBUTTON") then
						this:StartMoving();
					end
				end)();
				]]>
			</OnMouseDown>
			<OnMouseUp>
				<![CDATA[
				Kitty.protectFunction(function()
					this:StopMovingOrSizing();
					Kitty.savePosition(this);
				end)();
				]]>
			</OnMouseUp>
		</Scripts>
	</Frame>
</Ui>
