	<!-- List row (template) -->
	<Button name="KittyCommandListDetailTemplate" virtual="true" enableMouse="true">
		<!-- Highlight texture -->
		<HighlightTexture file="Interface/AuctionFrame/AuctionFrameItem-Highlight" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
		</HighlightTexture>

		<Layers>
			<Layer>
				<!-- List row (command list name) -->
				<FontString name="$parentName" justifyH="LEFT" inherits="Font_Normal" text="Name">
					<Size><AbsDimension x="150" /></Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
							<Offset><AbsDimension x="12" y="0" /></Offset>
						</Anchor>
					</Anchors>
					<FontHeight><AbsValue val="12" /></FontHeight>
				</FontString>

				<!-- List row (class icon) -->
				<Texture name="$parentClassIcon" hidden="true">
					<Size><AbsDimension x="24" y="24" /></Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
							<Offset><AbsDimension x="166" y="0" /></Offset>
						</Anchor>
					</Anchors>
				</Texture>

				<!-- List row (class) -->
				<FontString name="$parentClass" justifyH="LEFT" inherits="Font_Normal" text="Class">
					<Size><AbsDimension x="64" /></Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
							<Offset><AbsDimension x="196" y="0" /></Offset>
						</Anchor>
					</Anchors>
					<FontHeight><AbsValue val="12" /></FontHeight>
				</FontString>

				<!-- List row (target) -->
				<FontString name="$parentTarget" justifyH="LEFT" inherits="Font_Normal" text="Target">
					<Size><AbsDimension x="64" /></Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
							<Offset><AbsDimension x="266" y="0" /></Offset>
						</Anchor>
					</Anchors>
					<FontHeight><AbsValue val="12" /></FontHeight>
				</FontString>
			</Layer>
		</Layers>

		<Frames>
			<!-- Button (edit) -->
			<Button name="$parentEditButton" inherits="UIPanelButtonTemplate" text="EditButton">
				<Size><AbsDimension x="90" y="26" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
						<Offset><AbsDimension x="340" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandListFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local commandList = Kitty.CommandListFrame.allCommandList[index]
							local strList = Kitty.ComboManager.commandListHelp(commandList);

							GameTooltip:SetOwner(this, "ANCHOR_RIGHT", 4, 0);
							if(commandList.info ~= nil) then
								-- Command list name
								GameTooltip:SetText(commandList.info.name);
							end
							for index, value in ipairs(strList) do
								if(index == 1) then
									GameTooltip:AddSeparator();
								end

								if(type(value) ~= "table") then
									-- Command name
									GameTooltip:AddLine(tostring(value));
								else
									-- Conditions
									for index, str in ipairs(value) do
										GameTooltip:AddDoubleLine(" ", tostring(str));
									end
								end
							end
							GameTooltip:Show();
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							GameTooltip:Hide();
						end)();
						]]>
					</OnLeave>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandListFrame.onClick(this);
						end)();
						]]>
					</OnClick>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandListFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Button>

			<!-- Button (up) -->
			<Button name="$parentUpButton">
				<Size>
					<AbsDimension x="18" y="17" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="442" y="1" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local fromIndex = KittyCommandListFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local toIndex = fromIndex - 1;
							if(Kitty.CommandListFrame.allCommandList:swap(fromIndex, toIndex)) then
								Kitty.CommandListFrame.onRedraw(CommandListFrame, tonumber(KittyCommandListFrame_ScrollBar:GetValue()), 10);
							end
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "MoveUp"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandListFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
				<NormalTexture file="Interface/Buttons/PanelUpButton-Normal">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</NormalTexture>
				<PushedTexture file="Interface/Buttons/PanelUpButton-Depress">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</PushedTexture>
				<DisabledTexture file="Interface/Buttons/PanelUpButton-Disable">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</DisabledTexture>
				<HighlightTexture file="Interface/Buttons/PanelUpButton-Highlight" alphaMode="ADD" />
			</Button>

			<!-- Button (down) -->
			<Button name="$parentDownButton">
				<Size>
					<AbsDimension x="18" y="17" />
				</Size>
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentUpButton" relativePoint="BOTTOM">
						<Offset><AbsDimension x="0" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local fromIndex = KittyCommandListFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local toIndex = fromIndex + 1;
							if(Kitty.CommandListFrame.allCommandList:swap(fromIndex, toIndex)) then
								Kitty.CommandListFrame.onRedraw(CommandListFrame, tonumber(KittyCommandListFrame_ScrollBar:GetValue()), 10);
							end
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "MoveDown"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandListFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
				<NormalTexture file="Interface/Buttons/PanelDownButton-Normal">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</NormalTexture>
				<PushedTexture file="Interface/Buttons/PanelDownButton-Depress">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</PushedTexture>
				<DisabledTexture file="Interface/Buttons/PanelDownButton-Disable">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</DisabledTexture>
				<HighlightTexture file="Interface/Buttons/PanelUpButton-Highlight" alphaMode="ADD" />
			</Button>

			<!-- Button (plus) -->
			<Button name="$parentPlusButton" inherits="UIPlusButtonTemplate">
				<Size>
					<AbsDimension x="18" y="17" />
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentUpButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="4" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandListFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							Kitty.CommandListFrame.allCommandList:copy(index);
							-- Update the command list name
							local commandListName = Kitty.CommandListFrame.allCommandList[index+1].info.name;
							Kitty.CommandListFrame.allCommandList[index+1].info.name = commandListName .. "_copy";
							Kitty.CommandListFrame.onRedraw(KittyCommandListFrame, tonumber(KittyCommandListFrame_ScrollBar:GetValue()), 10);
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "Copy"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandListFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Button>

			<!-- Button (minus) -->
			<Button name="$parentMinusButton" inherits="UIMinusButtonTemplate">
				<Size>
					<AbsDimension x="18" y="17" />
				</Size>
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentPlusButton" relativePoint="BOTTOM">
						<Offset><AbsDimension x="0" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandListFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							Kitty.CommandListFrame.allCommandList:remove(index);
							Kitty.CommandListFrame.onRedraw(KittyCommandListFrame, tonumber(KittyCommandListFrame_ScrollBar:GetValue()), 10);
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "Remove"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandListFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
			</OnLoad>
			<OnClick>
				<![CDATA[
				Kitty.protectFunction(function()
					local messageList = {
						Kitty.T("message", "CommandListSelection01"),
						Kitty.T("message", "CommandListSelection02"),
						Kitty.T("message", "CommandListSelection03"),
						Kitty.T("message", "CommandListSelection04"),
						Kitty.T("message", "CommandListSelection05"),
						Kitty.T("message", "CommandListSelection06"),
						Kitty.T("message", "CommandListSelection07"),
						Kitty.T("message", "CommandListSelection08"),
						Kitty.T("message", "CommandListSelection09"),
						Kitty.T("message", "CommandListSelection10"),
						Kitty.T("message", "CommandListSelection11"),
						Kitty.T("message", "CommandListSelection12"),
						Kitty.T("message", "CommandListSelection13"),
						Kitty.T("message", "CommandListSelection14"),
						Kitty.T("message", "CommandListSelection15"),
						Kitty.T("message", "CommandListSelection16"),
						Kitty.T("message", "CommandListSelection17"),
						Kitty.T("message", "CommandListSelection18"),
						Kitty.T("message", "CommandListSelection19"),
						Kitty.T("message", "CommandListSelection20"),
					};
					Kitty.showGameTooltip(this, messageList);
				end)();
				]]>
			</OnClick>
			<OnEnter>
			</OnEnter>
			<OnLeave>
				<![CDATA[
				Kitty.protectFunction(function()
					Kitty.hideGameTooltip(this);
				end)();
				]]>
			</OnLeave>
			<OnMouseWheel>
				<![CDATA[
				Kitty.protectFunction(function()
					if(delta > 0) then
						KittyCommandListFrame_ScrollBar:SetValue(KittyCommandListFrame_ScrollBar:GetValue() - 1);
					elseif(delta < 0) then
						KittyCommandListFrame_ScrollBar:SetValue(KittyCommandListFrame_ScrollBar:GetValue() + 1);
					end
				end)();
				]]>
			</OnMouseWheel>
		</Scripts>
	</Button>

	<!-- Slider (template) -->
