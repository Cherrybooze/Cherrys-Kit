	<!-- Command lists window (look: Kitty.Skin.SPECS.KittyCommandListFrame) -->
	<Frame name="KittyCommandListFrame" parent="UIParent" frameStrata="MEDIUM" enableMouse="true" hidden="true">
		<!-- Window size -->
		<Size><AbsDimension x="580" y="556" /></Size>
		<!-- Position -->
		<Anchors>
			<Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER" />
			<Offset><AbsDimension x="0" y="0" /></Offset>
		</Anchors>

		<Layers>
			<Layer level="BACKGROUND">
				<!-- Cherry's KittyCombo skin: panel colour, set by Kitty.Skin -->
				<Texture name="$parent_SkinBg">
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
				</Texture>
				<!-- Addon name and version, next to the kitty -->
				<FontString name="KittyCommandListFrame_VersionLabel" inherits="GameTitleFont" justifyH="LEFT" text="VersionLabel">
					<Size><AbsDimension x="400" y="24" /></Size>
					<FontHeight><AbsValue val="18" /></FontHeight>
				</FontString>

				<!-- Title: "Command lists" -->
				<FontString name="KittyCommandListFrame_TitleLabel" inherits="GameFontNormal" justifyH="LEFT" text="TitleLabel">
					<Size><AbsDimension x="300" y="24" /></Size>
					<FontHeight><AbsValue val="17" /></FontHeight>
				</FontString>

				<!-- Footer: "10 command lists" -->
				<FontString name="KittyCommandListFrame_FooterLabel" inherits="GameFontNormal" justifyH="LEFT" text="">
					<Size><AbsDimension x="250" y="20" /></Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT">
							<Offset><AbsDimension x="22" y="-22" /></Offset>
						</Anchor>
					</Anchors>
					<FontHeight><AbsValue val="12" /></FontHeight>
				</FontString>
			</Layer>
		</Layers>

		<Frames>
			<!-- Corner grip: window size -->
			<Button name="$parent_Grip" inherits="KittyResizeGripTemplate" />

			<!-- Button (new) -->
			<Button name="KittyCommandListFrame_CreateButton" inherits="UIPanelButtonTemplate" text="CreateButton">
				<Size><AbsDimension x="150" y="28" /></Size>
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
						<Offset><AbsDimension x="-130" y="58" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						Kitty.CommandListFrame.onClick(this, true);
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.L("CreateTip", "Make a new command list: the skills to use, from most to least important."));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
				</Scripts>
			</Button>

			<!-- Button (import): new kitty from a share code. Replaces 0.973's "Initialization",
			     which swapped every kitty for the defaults without asking. -->
			<Button name="KittyCommandListFrame_ImportButton" inherits="UIPanelButtonTemplate" text="ImportButton">
				<Size><AbsDimension x="100" y="28" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyCommandListFrame_CreateButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="10" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandListFrame.onImport(this);
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.L("ImportNewTip", "Add a kitty from a share code (CKC2!...)."));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
				</Scripts>
			</Button>

			<!-- List -->
			<Frame name="KittyCommandListFrame_List" enableMouse="true">
				<Size><AbsDimension x="520" y="404" /></Size>
