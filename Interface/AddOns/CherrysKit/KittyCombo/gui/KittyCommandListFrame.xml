						<Offset><AbsDimension x="20" y="96" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<!-- Cherry's KittyCombo skin: panel colour, set by Kitty.Skin -->
