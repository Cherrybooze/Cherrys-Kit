							dropDown:setListData(
								function(this, button, value, text, previousValue, previousText)
									Kitty.CommandConditionFrame.updateData(this:GetParent());
									Kitty.CommandConditionFrame.onShowList(KittyCommandConditionFrame_ScrollBar, tonumber(KittyCommandConditionFrame_ScrollBar:GetValue()), 10);
								end,
								{"name", "id", "original"}
							);
						end)();
						]]>
					</OnLoad>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
