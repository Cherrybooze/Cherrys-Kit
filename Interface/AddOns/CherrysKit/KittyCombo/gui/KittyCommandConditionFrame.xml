			<!-- Button (up) -->
			<Button name="$parentUpButton">
				<Size>
					<AbsDimension x="20" y="20" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="512" y="3" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local fromIndex = KittyCommandConditionFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local toIndex = fromIndex - 1;
							if(Kitty.CommandConditionFrame.targetConditionList:swap(fromIndex, toIndex)) then
								Kitty.CommandConditionFrame.onRedraw(KittyCommandConditionFrame, tonumber(KittyCommandConditionFrame_ScrollBar:GetValue()), 10);
							end
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "MoveUp"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
