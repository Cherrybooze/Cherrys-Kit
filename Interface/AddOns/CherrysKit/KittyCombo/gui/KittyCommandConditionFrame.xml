						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConditionFrame.onShowList(this, tonumber(this:GetValue()), 10);
						end)();
						]]>
					</OnValueChanged>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							if(delta > 0) then
								this:SetValue(this:GetValue() - 1);
							elseif(delta < 0) then
								this:SetValue(this:GetValue() + 1);
							end
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Slider>

			<!-- Button (close) -->
			<Button name="KittyCommandConditionFrame_CloseButton" inherits="UIPanelButtonTemplate" text="CloseButton">
				<Size><AbsDimension x="100" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset><AbsDimension x="-128" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConditionFrame.save();
							if(Kitty.CommandConditionFrame.callbackFunc ~= nil) then
								Kitty.CommandConditionFrame.callbackFunc(Kitty.CommandConditionFrame.commandList);
							else
								Kitty.sendMessage("callbackFunc is nil.", "DEFAULT", 1, 0, 0);
							end
							Kitty.CommandConditionFrame.close();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>

			<!-- Button (cancel) -->
			<Button name="KittyCommandConditionFrame_CancelButton" inherits="UIPanelButtonTemplate" text="CancelButton">
				<Size><AbsDimension x="100" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset><AbsDimension x="-22" y="-14" /></Offset>
					</Anchor>
				</Anchors>
