				<![CDATA[
				Kitty.protectFunction(function()
					-- Hide the level-1 list
					CloseDropDownMenus();
				end)();
				]]>
			</OnHide>
			<OnLoad>
			</OnLoad>
			<OnEvent>
			</OnEvent>
			<OnMouseDown>
				<![CDATA[
				Kitty.protectFunction(function()
					-- A click on the window closes an open KittyCombo menu
					CloseDropDownMenus();
					if(key=="LBUTTON") then
						this:StartMoving();
					end
				end)();
				]]>
			</OnMouseDown>
			<OnMouseUp>
				<![CDATA[
				Kitty.protectFunction(function()
					this:StopMovingOrSizing();
