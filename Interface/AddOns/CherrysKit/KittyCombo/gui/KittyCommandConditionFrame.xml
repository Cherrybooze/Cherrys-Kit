					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Level-1 list
							local level1List = {};
							local groupedList = Kitty.BuildManager.getGroupedList();
							for key, value in pairs(groupedList) do
								table.insert(level1List, key);
							end
							table.sort(level1List);

							local level2List = {};
							for index, key in ipairs(level1List) do
								level2List[index] = {};
								for _, value in ipairs(groupedList[key]) do
									table.insert(level2List[index], value);
								end
							end

							-- Level-2 list
							local dropDown = Kitty.DropDown(this);
							dropDown:setListData(
								function(button)
									Kitty.CommandConditionFrame.updateData(this:GetParent());
								end,
								level1List,
								level2List
							);
						end)();
						]]>
