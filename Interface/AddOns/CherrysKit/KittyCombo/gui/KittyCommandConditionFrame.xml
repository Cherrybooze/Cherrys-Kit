							<Anchors>
								<Anchor point="TOPLEFT" />
								<Anchor point="BOTTOMRIGHT" />
							</Anchors>
						</Texture>
						<Texture name="$parent_Highlight" file="Interface/Login/Common/ServerlistButton-Highlight" hidden="true" />
					</Layer>
				</Layers>
				<Frames>
					<Button name="KittyCommandConditionFrame_Button1"  inherits="KittyCommandConditionDetailTemplate" id="1" />
					<Button name="KittyCommandConditionFrame_Button2"  inherits="KittyCommandConditionDetailTemplate" id="2" />
					<Button name="KittyCommandConditionFrame_Button3"  inherits="KittyCommandConditionDetailTemplate" id="3" />
					<Button name="KittyCommandConditionFrame_Button4"  inherits="KittyCommandConditionDetailTemplate" id="4" />
					<Button name="KittyCommandConditionFrame_Button5"  inherits="KittyCommandConditionDetailTemplate" id="5" />
					<Button name="KittyCommandConditionFrame_Button6"  inherits="KittyCommandConditionDetailTemplate" id="6" />
					<Button name="KittyCommandConditionFrame_Button7"  inherits="KittyCommandConditionDetailTemplate" id="7" />
					<Button name="KittyCommandConditionFrame_Button8"  inherits="KittyCommandConditionDetailTemplate" id="8" />
					<Button name="KittyCommandConditionFrame_Button9"  inherits="KittyCommandConditionDetailTemplate" id="9" />
					<Button name="KittyCommandConditionFrame_Button10" inherits="KittyCommandConditionDetailTemplate" id="10" />
				</Frames>
				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Position the rows in the list
							for index=1, 10 do
								getglobal("KittyCommandConditionFrame_Button" .. index):ClearAllAnchors();
								getglobal("KittyCommandConditionFrame_Button" .. index):SetAnchor("TOPLEFT", "TOPLEFT", "KittyCommandConditionFrame_List", 0, (index-1)*46 + 4);
								getglobal("KittyCommandConditionFrame_Button" .. index):SetAnchor("BOTTOMRIGHT", "TOPRIGHT", "KittyCommandConditionFrame_List", 0, index*46 + 4);
							end;
						end)();
						]]>
					</OnLoad>
					<OnShow>
					</OnShow>
				</Scripts>
			</Frame>

			<!-- Slider -->
			<Slider name="KittyCommandConditionFrame_ScrollBar" inherits="KittyCommandConditionSliderTemplate">
				<Size><AbsDimension x="10" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="KittyCommandConditionFrame_List" relativePoint="TOPRIGHT">
						<Offset><AbsDimension x="10" y="20" /></Offset>
					</Anchor>
					<Anchor point="BOTTOMLEFT" relativeTo="KittyCommandConditionFrame_List" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="10" y="-20" /></Offset>
					</Anchor>
				</Anchors>
