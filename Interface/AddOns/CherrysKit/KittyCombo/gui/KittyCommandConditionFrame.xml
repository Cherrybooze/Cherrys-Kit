	<!-- List row (template) -->
	<Button name="KittyCommandConditionDetailTemplate" virtual="true" enableMouse="true">
		<!-- Highlight texture -->
		<HighlightTexture file="Interface/AuctionFrame/AuctionFrameItem-Highlight" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
		</HighlightTexture>
		<Layers>
			<Layer level="ARTWORK">
				<!-- What the row checks, in one plain sentence (Kitty.CommandConditionFrame.summary) -->
				<FontString name="$parentSummary" inherits="GameFontNormal" justifyH="LEFT" text="">
					<Size><AbsDimension x="490" y="14" /></Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT">
							<Offset><AbsDimension x="12" y="-4" /></Offset>
						</Anchor>
					</Anchors>
					<FontHeight><AbsValue val="11" /></FontHeight>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<!-- Dropdown (condition type) -->
			<Frame name="$parentDropDownMenu" inherits="UIDropDownMenuTemplate" enableMouse="true">
				<Size><AbsDimension x="80" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
						<Offset><AbsDimension x="5" y="-7" /></Offset>
					</Anchor>
				</Anchors>

				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Build the condition list (grouped, see Kitty.ComboManager.getConditionMenu)
							local level1, level2 = Kitty.ComboManager.getConditionMenu();
							local dropDown = Kitty.DropDown(this, 150);
							dropDown:setListData(
								function(this, button, value, text, previousValue, previousText)
									-- Update the picked value (the menu shows friendly names)
									local index = KittyCommandConditionFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
									Kitty.CommandConditionFrame.targetConditionList[index] = {["conditionType"] = Kitty.ComboManager.conditionFromLabel(button:GetText())};
									Kitty.CommandConditionFrame.onShowList(KittyCommandConditionFrame_ScrollBar, tonumber(KittyCommandConditionFrame_ScrollBar:GetValue()), 10);
								end,
								level1,
								function(index, item)
									return level2[index] or nil;
								end
							);
						end)();
						]]>
					</OnLoad>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Describe the chosen condition (the grouped menu has no room for it)
							local label = UIDropDownMenu_GetText(this);
							local conditionType = Kitty.ComboManager.conditionFromLabel(label);
							local describe = conditionType and conditionType ~= "" and Kitty.ComboManager[conditionType .. "Describe"];
							if(not describe) then
								Kitty.showGameTooltip(this, {Kitty.L("ConditionPickTitle", "What to check"),
									Kitty.L("ConditionPickHint", "Pick what to check from the menu on the left.")});
							else
								local lines = {label};
								for _, line in ipairs(describe(nil, nil)) do
									if(line ~= "") then
										table.insert(lines, line);
									end
								end
								Kitty.showGameTooltip(this, lines);
							end
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConditionFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Frame>

			<!-- Dropdown (effect kind) -->
			<Frame name="$parentEffectTypeDropDownMenu" inherits="UIDropDownMenuTemplate">
				<Size><AbsDimension x="110" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentDropDownMenu" relativePoint="RIGHT">
