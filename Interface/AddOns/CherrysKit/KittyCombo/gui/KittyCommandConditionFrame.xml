			<!-- Dropdown (buff kind) -->
			<Frame name="$parentConditionDropDownMenu" inherits="UIDropDownMenuTemplate">
				<Size><AbsDimension x="80" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentEffectTypeDropDownMenu" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>

				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Get the buff kind list
							local getBuffList = function(isBuff)
								local list = {};
								for key, value in pairs(Kitty.BuffManager.effectNameList) do
									if(value.isBuff == isBuff) then
										table.insert(list, key);
									end
								end
								table.sort(list);

								-- Split the table (menus hold at most 32 entries)
								local list1 = {};
								for index = 1, 30 do
									table.insert(list1, list[index]);
								end
								local list2 = {};
								for index = 31, 60 do
									table.insert(list2, list[index]);
								end
								local list3 = {};
								for index = 61, #list do
									table.insert(list3, list[index]);
								end

								return list1, list2, list3;
							end;

							local buffList1, buffList2, buffList3 = getBuffList(true);
							local debuffList1, debuffList2, debuffList3 = getBuffList(false);

							local dropDown = Kitty.DropDown(this, 120);
							dropDown:setListData(
								function(this, button, value, text, previousValue, previousText)
									Kitty.CommandConditionFrame.updateData(this:GetParent());
								end,
								{"buff1", "buff2", "buff3", "debuff1", "debuff2", "debuff3"},
								{buffList1, buffList2, buffList3, debuffList1, debuffList2, debuffList3}
							);
						end)();
						]]>
					</OnLoad>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConditionFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Frame>

