				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyBasicConfigFrame_CommandListButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							KittyBasicConfigFrame:Hide();
							Kitty.Changelog.open();
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, "What changed since KittyCombo 0.973, and how to report bugs.");
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
				</Scripts>
			</Button>

			<!-- Button (save and close) -->
			<Button name="KittyBasicConfigFrame_CloseButton" inherits="UIPanelButtonTemplate" text="CloseButton">
				<Size><AbsDimension x="100" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="-128" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.BasicConfigFrame.onSave(this);
							KittyBasicConfigFrame:Hide();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>

			<!-- Button (cancel) -->
			<Button name="KittyBasicConfigFrame_CancelButton" inherits="UIPanelButtonTemplate" text="CancelButton">
				<Size><AbsDimension x="100" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="-22" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							KittyBasicConfigFrame:Hide();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>
		</Frames>

		<!-- Scripts -->
		<Scripts>
			<OnShow>
				<![CDATA[
				Kitty.protectFunction(function()
					Kitty.Skin.onShow(this);
					Kitty.BasicConfigFrame.onShow(this);
				end)();
				]]>
			</OnShow>
			<OnHide>
				<![CDATA[
				Kitty.protectFunction(function()
					-- Hide the level-1 list
					CloseDropDownMenus();
				end)();
				]]>
			</OnHide>
			<OnMouseDown>
				<![CDATA[
				Kitty.protectFunction(function()
					-- A click on the window closes an open KittyCombo menu
					CloseDropDownMenus();
					if(key=="LBUTTON") then
						this:StartMoving();
					end
				end)();
				]]>
			</OnMouseDown>
			<OnMouseUp>
				<![CDATA[
				Kitty.protectFunction(function()
					this:StopMovingOrSizing();
					Kitty.savePosition(this);
				end)();
				]]>
			</OnMouseUp>
		</Scripts>

	</Frame>
</Ui>
