	<!-- List row (template) -->
	<Button name="KittyCommandConfigDetailTemplate" virtual="true" enableMouse="true">
		<!-- Highlight texture -->
		<HighlightTexture file="Interface/AuctionFrame/AuctionFrameItem-Highlight" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
		</HighlightTexture>
		<Layers>
			<Layer level="OVERLAY">
				<!-- Priority number, left of the row: 1 = checked first -->
				<FontString name="$parentRank" inherits="GameTitleFont" justifyH="RIGHT" text="">
					<Size><AbsDimension x="28" y="20" /></Size>
					<FontHeight><AbsValue val="14" /></FontHeight>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parent" relativePoint="LEFT">
							<Offset><AbsDimension x="-3" y="0" /></Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<!-- Check box (enabled) -->
			<CheckButton name="$parentCheckButton" inherits="UIPanelCheckButtonTemplate">
				<Size><AbsDimension x="27" y="27" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.updateData(this:GetParent());
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "EnableDisable"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</CheckButton>

			<!-- Dropdown box (command icon) -->
			<CheckButton name="$parentActionButton" inherits="ActionButtonTemplate">
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentCheckButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>

				<Scripts>
					<OnLoad>
					</OnLoad>
					<OnReceiveDrag>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.onDrop(this);
						end)();
						]]>
					</OnReceiveDrag>
					<OnDragStart>
					</OnDragStart>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandConfigFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local command = Kitty.CommandConfigFrame.targetCommandList[index];
							if(command.commandType == "changemode") then
								Kitty.showGameTooltip(this,{Kitty.L("ModeActionTitle", "Change kitty mode"),
									Kitty.ModeUI.validModeName(command.commandName) and command.commandName or Kitty.L("ModeActionChoose", "Choose mode..."),
									Kitty.L("ModeActionIconClick", "Click to pick the mode icon.")});
								return;
							end
							if(command.commandName ~= nil and command.commandName ~= "") then
								local actionType, index1, index2 = Kitty.CommandConfigFrame.getActionType(command.commandName);

								-- Show the hyperlink
								if(actionType == Kitty.DragAndDropManager.SKILL) then
									GameTooltip:SetSkillItem(index1, index2);
								elseif(actionType == Kitty.DragAndDropManager.SUIT_SKILL) then
									GameTooltip:SetSuitSkillListItem(index1);
								elseif(actionType == Kitty.DragAndDropManager.EMOTE) then
									-- Show the name only
									GameTooltip:SetText(tostring(command.commandName));
								elseif(actionType == Kitty.DragAndDropManager.MACRO) then
									-- Show the name only
									GameTooltip:SetText(tostring(command.commandName));
								elseif(actionType == Kitty.DragAndDropManager.ACTION) then
									GameTooltip:SetActionItem(index1);
								else
									-- Show the name only
									GameTooltip:SetText(tostring(command.commandName));
								end

								GameTooltip:SetOwner(this, "ANCHOR_RIGHT", 4, 0);
								GameTooltip:Show();
							end
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							GameTooltip:Hide();
						end)();
						]]>
					</OnLeave>
					<OnShow>
					</OnShow>
					<OnClick>
						Kitty.protectFunction(function() Kitty.CommandConfigFrame.openModePicker(this:GetParent()); end)();
					</OnClick>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</CheckButton>

			<!-- Dropdown (command type) -->
			<Frame name="$parentDropDownMenu" inherits="UIDropDownMenuTemplate">
				<Size><AbsDimension x="80" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentActionButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>

				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							local dropDown = Kitty.DropDown(this);
							dropDown:setListData(
								function(this, button, value, text, previousValue, previousText)
									Kitty.CommandConfigFrame.onTypeChanged(this:GetParent());
								end,
								{"skill", "suitskill", "action", "extra", "macro", "emote", "proc", "changemode", "other"},
								{[9]={"break", "debug"}}
							);
						end)();
						]]>
					</OnLoad>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Frame>

			<!-- Edit box (command name) -->
			<EditBox name="$parentCommandNameEditBox" inherits="UIPanelEditBoxTemplate" numeric="false" letters="48" historyLines="0" autoFocus="false" multiLine="false">
				<Size><AbsDimension x="150" y="20" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentDropDownMenu" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "CompleteInput"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnTextChanged>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.updateData(this:GetParent());
						end)();
						]]>
					</OnTextChanged>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</EditBox>

			<!-- A mode action selects its named mode through the shared icon picker. -->
			<Button name="$parentModeButton" inherits="UIPanelButtonTemplate" text="Choose mode..." hidden="true">
				<Size><AbsDimension x="150" y="22" /></Size>
				<Anchors><Anchor point="LEFT" relativeTo="$parentDropDownMenu" relativePoint="RIGHT"><Offset><AbsDimension x="5" y="0" /></Offset></Anchor></Anchors>
				<Scripts><OnClick>Kitty.protectFunction(function() Kitty.CommandConfigFrame.openModePicker(this:GetParent()); end)();</OnClick>
				<OnEnter>Kitty.showGameTooltip(this,{Kitty.L("ModeActionTitle", "Change kitty mode"),Kitty.L("ModeActionButtonHelp", "Pick the mode this action turns on. It only fires while that mode is off; you can edit that condition.")});</OnEnter>
				<OnLeave>Kitty.hideGameTooltip(this);</OnLeave>
				<OnMouseWheel>Kitty.scrollList(KittyCommandConfigFrame_ScrollBar,delta);</OnMouseWheel></Scripts>
			</Button>
			<!-- Dropdown (proc list) -->
			<Frame name="$parentCommandDropDownMenu" inherits="UIDropDownMenuTemplate">
				<Size><AbsDimension x="80" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentDropDownMenu" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>

				<Scripts>
					<OnShow>
						<![CDATA[
						Kitty.protectFunction(function()
							local getList = function(index, text)
								local commandListName = nil;
								if(Kitty.CommandConfigFrame.targetCommandList.info ~= nil) then
									commandListName = Kitty.CommandConfigFrame.targetCommandList.info.name;
								end

								local list = {};
								for index, commandList in pairs(Kitty.CommandConfigFrame.allCommandList) do
									if(commandList.info ~= nil and commandList.info.name ~= nil) then
										-- proc only
										if(commandList.info.class == "proc") then
												if(commandList.info.name ~= commandListName) then
												-- If not me
												table.insert(list, commandList.info.name);
											end
										end
									end
								end
								return list;
							end;

							local dropDown = Kitty.DropDown(this, 120);
							dropDown:setListData(
								function(this, button, value, text, previousValue, previousText)
									Kitty.CommandConfigFrame.updateData(this:GetParent());
								end,
								getList
							);
						end)();
						]]>
					</OnShow>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Frame>

			<!-- Button (conditions) -->
			<Button name="$parentConditionButton" inherits="UIPanelButtonTemplate" text="ConditionButton">
				<Size><AbsDimension x="80" y="30" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentCommandNameEditBox" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandConfigFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local strList = Kitty.ComboManager.commandHelp(Kitty.CommandConfigFrame.targetCommandList[index]);

							GameTooltip:SetOwner(this, "ANCHOR_RIGHT", 4, 0);
							GameTooltip:SetText(Kitty.CommandConfigFrame.targetCommandList[index].commandName, 1, 1, 1);
							for index, value in ipairs(strList) do
								if(index == 1) then
									GameTooltip:AddSeparator();
								end
								GameTooltip:AddDoubleLine(" ", value, 1, 1, 1);
							end
							GameTooltip:Show();
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							GameTooltip:Hide();
						end)();
						]]>
					</OnLeave>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.onClick(this)
						end)();
						]]>
					</OnClick>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Button>

			<!-- Button (up) -->
			<Button name="$parentUpButton">
				<Size>
					<AbsDimension x="20" y="20" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="400" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local fromIndex = KittyCommandConfigFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local toIndex = fromIndex - 1;
							if(Kitty.CommandConfigFrame.targetCommandList:swap(fromIndex, toIndex)) then
								Kitty.CommandConfigFrame.onRedraw(KittyCommandConfigFrame, tonumber(KittyCommandConfigFrame_ScrollBar:GetValue()), 10);
							end
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, {Kitty.T("message", "MoveUp"), Kitty.L("MoveUpPriority", "Higher in the list = higher priority (checked earlier).")});
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
				<NormalTexture file="Interface/Buttons/PanelUpButton-Normal">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</NormalTexture>
				<PushedTexture file="Interface/Buttons/PanelUpButton-Depress">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</PushedTexture>
				<DisabledTexture file="Interface/Buttons/PanelUpButton-Disable">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</DisabledTexture>
				<HighlightTexture file="Interface/Buttons/PanelUpButton-Highlight" alphaMode="ADD" />
			</Button>

			<!-- Button (down) -->
			<Button name="$parentDownButton">
				<Size>
					<AbsDimension x="20" y="20" />
				</Size>
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentUpButton" relativePoint="BOTTOM">
						<Offset><AbsDimension x="0" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local fromIndex = KittyCommandConfigFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							local toIndex = fromIndex + 1;
							if(Kitty.CommandConfigFrame.targetCommandList:swap(fromIndex, toIndex)) then
								Kitty.CommandConfigFrame.onRedraw(KittyCommandConfigFrame, tonumber(KittyCommandConfigFrame_ScrollBar:GetValue()), 10);
							end
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, {Kitty.T("message", "MoveDown"), Kitty.L("MoveDownPriority", "Lower in the list = lower priority (checked later).")});
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
				<NormalTexture file="Interface/Buttons/PanelDownButton-Normal">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</NormalTexture>
				<PushedTexture file="Interface/Buttons/PanelDownButton-Depress">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</PushedTexture>
				<DisabledTexture file="Interface/Buttons/PanelDownButton-Disable">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875" />
				</DisabledTexture>
				<HighlightTexture file="Interface/Buttons/PanelUpButton-Highlight" alphaMode="ADD" />
			</Button>

			<!-- Button (plus) -->
			<Button name="$parentPlusButton" inherits="UIPlusButtonTemplate">
				<Size>
					<AbsDimension x="20" y="20" />
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentUpButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="0" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandConfigFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							if(IsShiftKeyDown() ~= true) then
								Kitty.CommandConfigFrame.targetCommandList:insert(index, {["commandType"]="", ["commandName"]="", ["icon"]="", ["enable"]=true});
							else
								Kitty.CommandConfigFrame.targetCommandList:copy(index);
							end
							Kitty.CommandConfigFrame.onRedraw(KittyCommandConfigFrame, tonumber(KittyCommandConfigFrame_ScrollBar:GetValue()), 10);
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "NewCreation"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						Kitty.hideGameTooltip(this);
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Button>

			<!-- Button (minus) -->
			<Button name="$parentMinusButton" inherits="UIMinusButtonTemplate">
				<Size>
					<AbsDimension x="20" y="20" />
				</Size>
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentPlusButton" relativePoint="BOTTOM">
						<Offset><AbsDimension x="0" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							local index = KittyCommandConfigFrame_ScrollBar:GetValue() + this:GetParent():GetID() - 1;
							if(IsShiftKeyDown() ~= true) then
								Kitty.CommandConfigFrame.targetCommandList:remove(index);
							else
								Kitty.CommandConfigFrame.targetCommandList:update(index, {["commandType"]="", ["commandName"]="", ["icon"]="", ["enable"]=true});
							end
							Kitty.CommandConfigFrame.onRedraw(KittyCommandConfigFrame, tonumber(KittyCommandConfigFrame_ScrollBar:GetValue()), 10);
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, Kitty.T("message", "Delete"));
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.scrollList(KittyCommandConfigFrame_ScrollBar, delta);
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
			</OnLoad>
			<OnClick>
				<![CDATA[
				Kitty.protectFunction(function()
					local messageList = {
						Kitty.T("message", "CommandListOrder01"),
						Kitty.T("message", "CommandListOrder02"),
						Kitty.T("message", "CommandListOrder03"),
						Kitty.T("message", "CommandListOrder04"),
						Kitty.T("message", "CommandListOrder05"),
						Kitty.T("message", "CommandListOrder06"),
						Kitty.T("message", "CommandListOrder07"),
						Kitty.T("message", "CommandListOrder08"),
						Kitty.T("message", "CommandListOrder09"),
						Kitty.T("message", "CommandListOrder10"),
						Kitty.T("message", "CommandListOrder11"),
						Kitty.T("message", "CommandListOrder12"),
						Kitty.T("message", "CommandListOrder13"),
						Kitty.T("message", "CommandListOrder14"),
						Kitty.T("message", "CommandListOrder15"),
						Kitty.T("message", "CommandListOrder16"),
						Kitty.T("message", "CommandListOrder17"),
						Kitty.T("message", "CommandListOrder18"),
						Kitty.T("message", "CommandListOrder19"),
						Kitty.T("message", "CommandListOrder20"),
						Kitty.T("message", "CommandListOrder21"),
						Kitty.T("message", "CommandListOrder22"),
						Kitty.T("message", "CommandListOrder23"),
						Kitty.T("message", "CommandListOrder24"),
						Kitty.T("message", "CommandListOrder25"),
						Kitty.T("message", "CommandListOrder26"),
					};
					Kitty.showGameTooltip(this, messageList);
				end)();
				]]>
			</OnClick>
			<OnEnter>
			</OnEnter>
			<OnLeave>
				<![CDATA[
				Kitty.protectFunction(function()
					Kitty.hideGameTooltip(this);
				end)();
				]]>
			</OnLeave>
			<OnMouseWheel>
				<![CDATA[
				Kitty.protectFunction(function()
					if(delta > 0) then
						KittyCommandConfigFrame_ScrollBar:SetValue(KittyCommandConfigFrame_ScrollBar:GetValue() - 1);
					elseif(delta < 0) then
						KittyCommandConfigFrame_ScrollBar:SetValue(KittyCommandConfigFrame_ScrollBar:GetValue() + 1);
					end
				end)();
				]]>
			</OnMouseWheel>
		</Scripts>
	</Button>

	<!-- Slider (template) -->
	<Slider name="KittyCommandConfigSliderTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentTop" file="Interface/Common/PanelScrollBar-Broder">
					<Size><AbsDimension x="16" y="16" /></Size>
					<Anchors>
						<Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
							<Offset><AbsDimension x="0" y="-20" /></Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0" right="1" top="0" bottom="0.25" />
				</Texture>
				<Texture name="$parentBottom" file="Interface/Common/PanelScrollBar-Broder">
					<Size><AbsDimension x="16" y="16" /></Size>
					<Anchors>
						<Anchor point="BOTTOM" relativeTo="$parent" relativePoint="BOTTOM">
							<Offset><AbsDimension x="0" y="20" /></Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0" right="1" top="0.75" bottom="1" />
				</Texture>
				<Texture name="$parentMiddle" file="Interface/Common/PanelScrollBar-Broder">
					<Size><AbsDimension x="16" y="1" /></Size>
					<Anchors>
						<Anchor point="TOP" relativeTo="$parentTop" relativePoint="BOTTOM" />
						<Anchor point="BOTTOM" relativeTo="$parentBottom" relativePoint="TOP" />
					</Anchors>
					<TexCoords left="0" right="1" top="0.25" bottom="0.75" />
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- Scroll up button -->
			<Button name="$parentScrollUpButton" inherits="UIPanelScrollUpButtonTemplate">
				<Anchors><Anchor point="BOTTOM" relativePoint="TOP" relativeTo="$parent" /></Anchors>
			</Button>
			<!-- Scroll down button -->
			<Button name="$parentScrollDownButton" inherits="UIPanelScrollDownButtonTemplate">
				<Anchors><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="$parent" /></Anchors>
			</Button>
