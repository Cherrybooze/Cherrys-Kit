						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
				</Scripts>
			</EditBox>

			<!-- Dropdown (build) -->
			<Frame name="KittyCommandConfigFrame_BuildDropDownMenu" inherits="UIDropDownMenuTemplate">
				<Size><AbsDimension x="80" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyCommandConfigFrame_CommandListNameEditBox" relativePoint="RIGHT">
						<Offset><AbsDimension x="50" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="KittyCommandConfigFrame_BuildLabel" inherits="GameTitleFont" text="BuildLabel">
							<FontHeight><AbsValue val="14" /></FontHeight>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parent" relativePoint="LEFT">
									<Offset><AbsDimension x="-5" y="0" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>

				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Level-1 list
							local level1List = {};
							local groupedList = Kitty.BuildManager.getGroupedList();
							for key, value in pairs(groupedList) do
								table.insert(level1List, key);
							end
							table.sort(level1List);

							local level2List = {};
							for index, key in ipairs(level1List) do
								level2List[index] = {};
								for _, value in ipairs(groupedList[key]) do
									table.insert(level2List[index], value);
								end
							end

							-- Level-2 list
							local dropDown = Kitty.DropDown(this);
							dropDown:setListData(
								function(button)
									Kitty.CommandConfigFrame.updateData();
								end,
								level1List,
								level2List
							);
						end)();
						]]>
					</OnLoad>
				</Scripts>
			</Frame>

			<!-- Dropdown (target) -->
			<Frame name="KittyCommandConfigFrame_TargetDropDownMenu" inherits="UIDropDownMenuTemplate">
				<Size><AbsDimension x="80" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyCommandConfigFrame_BuildDropDownMenu" relativePoint="RIGHT">
						<Offset><AbsDimension x="70" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="KittyCommandConfigFrame_TargetLabel" inherits="GameTitleFont" text="TargetLabel">
							<FontHeight><AbsValue val="14" /></FontHeight>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parent" relativePoint="LEFT">
									<Offset><AbsDimension x="-5" y="0" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>

				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							local dropDown = Kitty.DropDown(this);
							dropDown:setListData(
								function(this, button, value, text, previousValue, previousText)
									Kitty.CommandConfigFrame.updateData();
								end,
								{"all", "boss", "pc", "caster", "none"}
							);
						end)();
						]]>
					</OnLoad>
				</Scripts>
			</Frame>

			<!-- Share: export code / import code -->
			<EditBox name="KittyCommandConfigFrame_ExportEditBox" inherits="UIPanelEditBoxTemplate" letters="20000" historyLines="0" autoFocus="false" multiLine="false">
				<Size><AbsDimension x="150" y="20" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="75" y="78" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="KittyCommandConfigFrame_ExportLabel" inherits="GameTitleFont" text="">
							<FontHeight><AbsValue val="14" /></FontHeight>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parent" relativePoint="LEFT">
									<Offset><AbsDimension x="-5" y="0" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, {Kitty.L("ExportTooltip1", "Export code for this kitty."), Kitty.L("ExportTooltip2", "Click the box, then press Ctrl+C to copy it.")});
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnEscapePressed>
						<![CDATA[
						this:ClearFocus();
						]]>
					</OnEscapePressed>
				</Scripts>
			</EditBox>

			<Button name="KittyCommandConfigFrame_ExportButton" inherits="UIPanelButtonTemplate" text="">
				<Size><AbsDimension x="65" y="22" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyCommandConfigFrame_ExportEditBox" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.refreshExport(true);
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>

			<!-- Export code length, and a warning when it is too long for chat -->
			<Frame name="KittyCommandConfigFrame_ExportInfo">
				<Size><AbsDimension x="550" y="16" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="20" y="102" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="KittyCommandConfigFrame_ExportLengthLabel" inherits="GameFontNormal" justifyH="LEFT" text="">
							<Size><AbsDimension x="550" y="16" /></Size>
							<FontHeight><AbsValue val="12" /></FontHeight>
							<Anchors>
								<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT" />
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<EditBox name="KittyCommandConfigFrame_ImportEditBox" inherits="UIPanelEditBoxTemplate" letters="20000" historyLines="0" autoFocus="false" multiLine="false">
				<Size><AbsDimension x="140" y="20" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyCommandConfigFrame_ExportButton" relativePoint="RIGHT">
						<Offset><AbsDimension x="60" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="KittyCommandConfigFrame_ImportLabel" inherits="GameTitleFont" text="">
							<FontHeight><AbsValue val="14" /></FontHeight>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parent" relativePoint="LEFT">
									<Offset><AbsDimension x="-5" y="0" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, {Kitty.L("ImportTooltip1", "Paste a code here (Ctrl+V), then press Import."), Kitty.L("ImportTooltip2", "It replaces the commands shown below. Nothing is saved until you press Save.")});
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
					<OnEscapePressed>
						<![CDATA[
						this:ClearFocus();
						]]>
					</OnEscapePressed>
				</Scripts>
			</EditBox>

			<Button name="KittyCommandConfigFrame_ImportButton" inherits="UIPanelButtonTemplate" text="">
				<Size><AbsDimension x="60" y="22" /></Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="KittyCommandConfigFrame_ImportEditBox" relativePoint="RIGHT">
						<Offset><AbsDimension x="5" y="0" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.importCode();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>

			<!-- Macro: create / pick up, with a status mark and the macro name -->
			<Button name="KittyCommandConfigFrame_MacroButton" inherits="UIPanelButtonTemplate" text="">
				<Size><AbsDimension x="110" y="22" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="20" y="128" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="KittyCommandConfigFrame_MacroStatusIcon" inherits="GameFontNormal" justifyH="CENTER" text="">
							<Size><AbsDimension x="20" y="20" /></Size>
							<FontHeight><AbsValue val="16" /></FontHeight>
							<Anchors>
								<Anchor point="LEFT" relativeTo="$parent" relativePoint="RIGHT">
									<Offset><AbsDimension x="6" y="0" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="KittyCommandConfigFrame_MacroStatusLabel" inherits="GameFontNormal" justifyH="LEFT" text="">
							<Size><AbsDimension x="400" y="20" /></Size>
							<FontHeight><AbsValue val="14" /></FontHeight>
							<Anchors>
								<Anchor point="LEFT" relativeTo="KittyCommandConfigFrame_MacroStatusIcon" relativePoint="RIGHT">
									<Offset><AbsDimension x="4" y="0" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.createMacro();
						end)();
						]]>
					</OnClick>
					<OnEnter>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.showGameTooltip(this, {Kitty.L("MacroTooltip1", "Makes a macro that runs this kitty, with a random icon."), Kitty.L("MacroTooltip2", "If it already exists, picks it up instead. Click an action bar slot to place it.")});
						end)();
						]]>
					</OnEnter>
					<OnLeave>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.hideGameTooltip(this);
						end)();
						]]>
					</OnLeave>
				</Scripts>
			</Button>

			<!-- List -->
			<Frame name="KittyCommandConfigFrame_List" enableMouse="true">
				<Size><AbsDimension x="500" y="420" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset><AbsDimension x="50" y="174" /></Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<!-- Cherry's KittyCombo skin: panel colour, set by Kitty.Skin -->
						<Texture name="$parent_SkinBg">
							<Anchors>
								<Anchor point="TOPLEFT" />
								<Anchor point="BOTTOMRIGHT" />
							</Anchors>
						</Texture>
						<Texture name="$parent_Highlight" file="Interface/Login/Common/ServerlistButton-Highlight" hidden="true" />
					</Layer>
					<Layer level="OVERLAY">
						<!-- Priority direction, above and below the list -->
						<FontString name="KittyCommandConfigFrame_PriorityTopLabel" inherits="GameFontNormal" justifyH="LEFT" text="">
							<Size><AbsDimension x="500" y="16" /></Size>
							<FontHeight><AbsValue val="13" /></FontHeight>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
									<Offset><AbsDimension x="0" y="-2" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="KittyCommandConfigFrame_PriorityBottomLabel" inherits="GameFontNormal" justifyH="LEFT" text="">
							<Size><AbsDimension x="300" y="16" /></Size>
							<FontHeight><AbsValue val="13" /></FontHeight>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT">
									<Offset><AbsDimension x="0" y="2" /></Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="KittyCommandConfigFrame_Button1"  inherits="KittyCommandConfigDetailTemplate" id="1" />
					<Button name="KittyCommandConfigFrame_Button2"  inherits="KittyCommandConfigDetailTemplate" id="2" />
					<Button name="KittyCommandConfigFrame_Button3"  inherits="KittyCommandConfigDetailTemplate" id="3" />
					<Button name="KittyCommandConfigFrame_Button4"  inherits="KittyCommandConfigDetailTemplate" id="4" />
					<Button name="KittyCommandConfigFrame_Button5"  inherits="KittyCommandConfigDetailTemplate" id="5" />
					<Button name="KittyCommandConfigFrame_Button6"  inherits="KittyCommandConfigDetailTemplate" id="6" />
					<Button name="KittyCommandConfigFrame_Button7"  inherits="KittyCommandConfigDetailTemplate" id="7" />
					<Button name="KittyCommandConfigFrame_Button8"  inherits="KittyCommandConfigDetailTemplate" id="8" />
					<Button name="KittyCommandConfigFrame_Button9"  inherits="KittyCommandConfigDetailTemplate" id="9" />
					<Button name="KittyCommandConfigFrame_Button10" inherits="KittyCommandConfigDetailTemplate" id="10" />
				</Frames>
				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							-- Position the rows in the list
							for index=1, 10 do
								getglobal("KittyCommandConfigFrame_Button" .. index):ClearAllAnchors();
								getglobal("KittyCommandConfigFrame_Button" .. index):SetAnchor("TOPLEFT", "TOPLEFT", "KittyCommandConfigFrame_List", 0, (index-1)*40 + 10);
								getglobal("KittyCommandConfigFrame_Button" .. index):SetAnchor("BOTTOMRIGHT", "TOPRIGHT", "KittyCommandConfigFrame_List", 0, index*40 + 10);
							end;
						end)();
						]]>
					</OnLoad>
					<OnShow>
					</OnShow>
				</Scripts>
			</Frame>

			<!-- Slider -->
			<Slider name="KittyCommandConfigFrame_ScrollBar" inherits="KittyCommandConfigSliderTemplate">
				<Size><AbsDimension x="10" /></Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="KittyCommandConfigFrame_List" relativePoint="TOPRIGHT">
						<Offset><AbsDimension x="10" y="20" /></Offset>
					</Anchor>
					<Anchor point="BOTTOMLEFT" relativeTo="KittyCommandConfigFrame_List" relativePoint="BOTTOMRIGHT">
						<Offset><AbsDimension x="10" y="-20" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						<![CDATA[
						Kitty.protectFunction(function()
							this:SetValueStepMode("INT");
							this:SetMinMaxValues(1, 1);
						end)();
						]]>
					</OnLoad>
					<OnValueChanged>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.onShowList(this, tonumber(this:GetValue()), 10);
						end)();
						]]>
					</OnValueChanged>
					<OnMouseWheel>
						<![CDATA[
						Kitty.protectFunction(function()
							if(delta > 0) then
								this:SetValue(this:GetValue() - 1);
							elseif(delta < 0) then
								this:SetValue(this:GetValue() + 1);
							end
						end)();
						]]>
					</OnMouseWheel>
				</Scripts>
			</Slider>

			<!-- Button (save and close) -->
			<Button name="KittyCommandConfigFrame_CloseButton" inherits="UIPanelButtonTemplate" text="CloseButton">
				<Size><AbsDimension x="100" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset><AbsDimension x="-128" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							Kitty.CommandConfigFrame.save();
							if(Kitty.CommandConfigFrame.callbackFunc ~= nil) then
								Kitty.CommandConfigFrame.callbackFunc(Kitty.CommandConfigFrame.allCommandList);
							else
								Kitty.sendMessage("callbackFunc is nil.");
							end
							Kitty.CommandConfigFrame.close();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>

			<!-- Button (cancel) -->
			<Button name="KittyCommandConfigFrame_CancelButton" inherits="UIPanelButtonTemplate" text="CancelButton">
				<Size><AbsDimension x="100" y="30" /></Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset><AbsDimension x="-22" y="-14" /></Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						<![CDATA[
						Kitty.protectFunction(function()
							if(Kitty.CommandConfigFrame.callbackFunc ~= nil) then
								Kitty.CommandConfigFrame.callbackFunc(Kitty.CommandConfigFrame.allCommandList);
							else
								Kitty.sendMessage("callbackFunc is nil.");
							end
							Kitty.CommandConfigFrame.close();
						end)();
						]]>
					</OnClick>
				</Scripts>
			</Button>
		</Frames>

		<!-- Scripts -->
		<Scripts>
			<OnShow>
				<![CDATA[
				Kitty.protectFunction(function()
					Kitty.Skin.onShow(this);
					Kitty.CommandConfigFrame.onShow(this);
				end)();
				]]>
			</OnShow>
			<OnHide>
				<![CDATA[
				Kitty.protectFunction(function()
					-- Hide the level-1 list
					CloseDropDownMenus();
					Kitty.CommandConfigFrame.onHide(this);
				end)();
				]]>
			</OnHide>
			<OnLoad>
			</OnLoad>
			<OnEvent>
			</OnEvent>
			<OnMouseDown>
				<![CDATA[
				Kitty.protectFunction(function()
					-- A click on the window closes an open KittyCombo menu
					CloseDropDownMenus();
					if(key=="LBUTTON") then
						this:StartMoving();
					end
				end)();
				]]>
			</OnMouseDown>
			<OnMouseUp>
				<![CDATA[
				Kitty.protectFunction(function()
					this:StopMovingOrSizing();
					Kitty.savePosition(this);
				end)();
				]]>
			</OnMouseUp>
		</Scripts>
	</Frame>
</Ui>
