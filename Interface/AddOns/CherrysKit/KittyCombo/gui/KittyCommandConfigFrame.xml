			<Button name="$parent_Grip" inherits="KittyResizeGripTemplate" />
			<!-- Edit box (command list name) -->
			<EditBox name="KittyCommandConfigFrame_CommandListNameEditBox" inherits="UIPanelEditBoxTemplate" letters="64" historyLines="0" autoFocus="false" multiLine="false">
