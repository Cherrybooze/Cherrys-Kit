  <!-- Mass Mail Items Bags Template -->
  
  <Frame name="UMMMassSendItemsBagsTemplate" virtual="true" enableMouse="true">
    <Size>
      <AbsDimension x="780" y="470" />
    </Size>
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
        <Offset>
          <AbsDimension x="0" y="25" />	<!-- x="0" y="25" Position der Rucksackfächer y=hoch je kleiner xxxxxxxxxx-->
        </Offset>
      </Anchor>
    </Anchors>
    <Frames>
      <Frame name="$parentBag1" id="1" inherits="UMMMassSendItemsBagTemplate" />
      <Frame name="$parentBag2" id="2" inherits="UMMMassSendItemsBagTemplate" />
      <Frame name="$parentBag3" id="3" inherits="UMMMassSendItemsBagTemplate" />
      <Frame name="$parentBag4" id="4" inherits="UMMMassSendItemsBagTemplate" />
      <Frame name="$parentBag5" id="5" inherits="UMMMassSendItemsBagTemplate" />
      <Frame name="$parentBag6" id="6" inherits="UMMMassSendItemsBagTemplate" />
      <!-- Reuse a near-white opaque sample in the bundled border texture.
           Fixed XML textures keep the rubber band independent of optional addons. -->
      <Frame name="$parentSelection" enableMouse="false" frameLevel="20" hidden="true">
        <Size><AbsDimension x="1" y="1"/></Size>
        <Layers><Layer level="OVERLAY">
          <Texture name="$parentFill" file="Interface/AddOns/CherrysKit/UltimateMailMod/Textures/ItemTaggedBorder" alphaMode="BLEND">
            <Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
            <TexCoords left="0.2420" top="0.1014" right="0.2424" bottom="0.1017"/>
            <Color r="0.15" g="0.45" b="1" a="0.18"/>
          </Texture>
          <Texture name="$parentTop" file="Interface/AddOns/CherrysKit/UltimateMailMod/Textures/ItemTaggedBorder" alphaMode="BLEND">
            <Size><AbsDimension x="1" y="1"/></Size>
            <Anchors><Anchor point="TOPLEFT"/><Anchor point="TOPRIGHT"/></Anchors>
            <TexCoords left="0.2420" top="0.1014" right="0.2424" bottom="0.1017"/>
            <Color r="0.15" g="0.45" b="1" a="1"/>
          </Texture>
          <Texture name="$parentBottom" file="Interface/AddOns/CherrysKit/UltimateMailMod/Textures/ItemTaggedBorder" alphaMode="BLEND">
            <Size><AbsDimension x="1" y="1"/></Size>
            <Anchors><Anchor point="BOTTOMLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
            <TexCoords left="0.2420" top="0.1014" right="0.2424" bottom="0.1017"/>
            <Color r="0.15" g="0.45" b="1" a="1"/>
          </Texture>
          <Texture name="$parentLeft" file="Interface/AddOns/CherrysKit/UltimateMailMod/Textures/ItemTaggedBorder" alphaMode="BLEND">
            <Size><AbsDimension x="1" y="1"/></Size>
            <Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMLEFT"/></Anchors>
            <TexCoords left="0.2420" top="0.1014" right="0.2424" bottom="0.1017"/>
            <Color r="0.15" g="0.45" b="1" a="1"/>
          </Texture>
          <Texture name="$parentRight" file="Interface/AddOns/CherrysKit/UltimateMailMod/Textures/ItemTaggedBorder" alphaMode="BLEND">
            <Size><AbsDimension x="1" y="1"/></Size>
            <Anchors><Anchor point="TOPRIGHT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
            <TexCoords left="0.2420" top="0.1014" right="0.2424" bottom="0.1017"/>
            <Color r="0.15" g="0.45" b="1" a="1"/>
          </Texture>
        </Layer></Layers>
      </Frame>
      <EditBox name="$parentSelectionKeys" enableMouse="false" alpha="0" letters="1" historylines="0">
        <Size><AbsDimension x="1" y="1"/></Size>
        <Anchors><Anchor point="TOPLEFT"/></Anchors>
        <Scripts>
          <OnLoad>this:SetKeyboardEnable(false);</OnLoad>
          <OnEscapePressed>this:GetParent():CancelBoxSelection();</OnEscapePressed>
          <OnEditFocusLost>local grid=this:GetParent(); if grid.CancelBoxSelection then grid:CancelBoxSelection(); end</OnEditFocusLost>
        </Scripts>
      </EditBox>
    </Frames>
    <Scripts>
      <OnLoad>
        UMMMassSendItemsBagsTemplate_OnLoad(this);
      </OnLoad>
      <OnShow>
        UMMMassSendItemsBagsTemplate_OnShow(this);
      </OnShow>
      <OnHide>
        UMMMassSendItemsBagsTemplate_OnHide(this);
      </OnHide>
      <OnMouseDown>this:BeginBoxSelection(this, key);</OnMouseDown>
      <OnMouseUp>this:EndBoxSelection(key);</OnMouseUp>
      <OnUpdate>if this.priv_BoxDrag then this:UpdateBoxSelection(); end</OnUpdate>
      <OnEnter>UMMMassSelectionTip(this);</OnEnter>
      <OnLeave>GameTooltip:Hide();</OnLeave>
    </Scripts>
  </Frame>
  
