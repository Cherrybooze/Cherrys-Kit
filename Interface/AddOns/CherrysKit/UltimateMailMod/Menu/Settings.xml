      </EditBox>
      <EditBox name="$parentPreset2" inherits="UMMSettingsGoldPresetTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="178" y="295"/></Offset></Anchor></Anchors>
      </EditBox>
      <Button name="$parentSavePresets" inherits="UMMSettingsButtonTemplate">
        <Size><AbsDimension x="130" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="190" y="328"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_SavePresets();</OnClick></Scripts>
      </Button>
      <Button name="$parentCheck" inherits="UMMSettingsButtonTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="340" y="322"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("check");</OnClick></Scripts>
      </Button>
      <Button name="$parentTrace" inherits="UMMSettingsButtonTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="500" y="322"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("trace");</OnClick></Scripts>
      </Button>
      <Button name="$parentDefaults" inherits="UMMSettingsButtonTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="340" y="354"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("defaults");</OnClick></Scripts>
      </Button>
      <Button name="$parentReset" inherits="UMMSettingsButtonTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="500" y="354"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("resetchars");</OnClick></Scripts>
      </Button>
      <Button name="$parentConfirmYes" inherits="UMMSettingsButtonTemplate" hidden="true">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="340" y="354"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_ConfirmReset(true);</OnClick></Scripts>
      </Button>
      <Button name="$parentConfirmNo" inherits="UMMSettingsButtonTemplate" hidden="true">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="500" y="354"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_ConfirmReset(false);</OnClick></Scripts>
      </Button>
      <!-- Shown for one frame after a gold preset edit to put the commas back. -->
      <Frame name="$parentPresetFormat" hidden="true">
        <Size><AbsDimension x="0" y="0"/></Size>
        <Anchors><Anchor point="TOPLEFT"/></Anchors>
        <Scripts><OnUpdate>this:Hide(); UMMSettingsUI_FormatPresets();</OnUpdate></Scripts>
      </Frame>
    </Frames>
    <Scripts>
      <OnLoad>UMMSettingsUI_OnLoad(this);</OnLoad>
      <OnShow>UMMSettingsUI_Refresh(true);</OnShow>
      <OnHide>UMMSettingsUI_ConfirmReset(false);</OnHide>
    </Scripts>
  </Frame>
</Ui>
