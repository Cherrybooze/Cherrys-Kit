<Ui xmlns="http://www.runewaker.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/UI.xsd">
  <!-- Cherry's Kit: Ultimate Mail Mod settings window (/umm). All handlers live here in XML:
       RoM ignores script handlers set from Lua. -->

  <CheckButton name="UMMSettingsCheckTemplate" inherits="CommonOptionsCheckButtonTemplate" virtual="true">
    <Size><AbsDimension x="25" y="25"/></Size>
    <Scripts>
      <OnClick>UMMSettingsUI_Check(this:GetID(), this:IsChecked());</OnClick>
    </Scripts>
  </CheckButton>

  <Frame name="UMMSettingsNumberRowTemplate" virtual="true">
    <Size><AbsDimension x="300" y="28"/></Size>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentLabel" inherits="GameFontHighlight" justifyH="LEFT" text="">
          <Size><AbsDimension x="190" y="28"/></Size>
          <Anchors><Anchor point="LEFT"/></Anchors>
        </FontString>
        <FontString name="$parentValue" inherits="GameFontNormal" justifyH="CENTER" text="">
          <Size><AbsDimension x="44" y="28"/></Size>
          <Anchors><Anchor point="LEFT"><Offset><AbsDimension x="222" y="0"/></Offset></Anchor></Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentMinus" inherits="UIPanelButtonTemplate" text="-">
        <Size><AbsDimension x="26" y="22"/></Size>
        <Anchors><Anchor point="LEFT"><Offset><AbsDimension x="194" y="0"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Step(this:GetParent():GetID(), -1);</OnClick></Scripts>
      </Button>
      <Button name="$parentPlus" inherits="UIPanelButtonTemplate" text="+">
        <Size><AbsDimension x="26" y="22"/></Size>
        <Anchors><Anchor point="LEFT"><Offset><AbsDimension x="268" y="0"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Step(this:GetParent():GetID(), 1);</OnClick></Scripts>
      </Button>
    </Frames>
  </Frame>

  <!-- numeric only filters typing: the commas come from UMMSettingsUI_FormatPresets.
       11 letters = 999,999,999. -->
  <EditBox name="UMMSettingsGoldPresetTemplate" inherits="UIPanelEditBoxTemplate" virtual="true" numeric="true" letters="11" historylines="0">
    <Size><AbsDimension x="142" y="26"/></Size>
    <Scripts>
      <OnTextChanged>UMMSettingsUI_PresetEdited();</OnTextChanged>
      <OnEnterPressed>UMMSettingsUI_SavePresets(); this:ClearFocus();</OnEnterPressed>
      <OnEscapePressed>this:ClearFocus(); UMMSettingsUI_Refresh(true);</OnEscapePressed>
      <OnEnter>UMMSettingsUI_ShortcutTip(this);</OnEnter>
      <OnLeave>GameTooltip:Hide();</OnLeave>
    </Scripts>
  </EditBox>

  <Frame name="UMMSettingsFrame" parent="UIParent" inherits="UICommonFrameTemplate" enableMouse="true" frameStrata="DIALOG" hidden="true">
    <Size><AbsDimension x="340" y="548"/></Size>
    <Anchors><Anchor point="CENTER"/></Anchors>
    <Layers><Layer level="ARTWORK">
      <FontString name="$parentPreset1Label" inherits="GameFontHighlight" justifyH="LEFT" text="">
        <Size><AbsDimension x="150" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="348"/></Offset></Anchor></Anchors>
      </FontString>
      <FontString name="$parentPreset2Label" inherits="GameFontHighlight" justifyH="LEFT" text="">
        <Size><AbsDimension x="150" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="380"/></Offset></Anchor></Anchors>
      </FontString>
      <FontString name="$parentPresetStatus" inherits="GameFontNormal" justifyH="LEFT" text="">
        <Size><AbsDimension x="300" y="32"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="440"/></Offset></Anchor></Anchors>
      </FontString>
      <FontString name="$parentConfirmText" inherits="GameFontHighlight" justifyH="LEFT" text="" hidden="true">
        <Size><AbsDimension x="300" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="478"/></Offset></Anchor></Anchors>
      </FontString>
    </Layer></Layers>
    <Frames>
      <Frame name="$parentRow1" inherits="UMMSettingsNumberRowTemplate" id="1">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="40"/></Offset></Anchor></Anchors>
      </Frame>
      <Frame name="$parentRow2" inherits="UMMSettingsNumberRowTemplate" id="2">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="74"/></Offset></Anchor></Anchors>
      </Frame>
      <Frame name="$parentRow3" inherits="UMMSettingsNumberRowTemplate" id="3">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="108"/></Offset></Anchor></Anchors>
      </Frame>
      <Frame name="$parentRow4" inherits="UMMSettingsNumberRowTemplate" id="4">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="142"/></Offset></Anchor></Anchors>
      </Frame>
      <Frame name="$parentRow5" inherits="UMMSettingsNumberRowTemplate" id="5">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="176"/></Offset></Anchor></Anchors>
      </Frame>
      <CheckButton name="$parentCheck1" inherits="UMMSettingsCheckTemplate" id="1">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="219"/></Offset></Anchor></Anchors>
      </CheckButton>
      <CheckButton name="$parentCheck2" inherits="UMMSettingsCheckTemplate" id="2">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="249"/></Offset></Anchor></Anchors>
      </CheckButton>
      <CheckButton name="$parentCheck3" inherits="UMMSettingsCheckTemplate" id="3">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="279"/></Offset></Anchor></Anchors>
      </CheckButton>
      <CheckButton name="$parentCheck4" inherits="UMMSettingsCheckTemplate" id="4">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="309"/></Offset></Anchor></Anchors>
        <Scripts>
          <OnEnter>UMMSettingsUI_ShortcutTip(this);</OnEnter>
          <OnLeave>GameTooltip:Hide();</OnLeave>
        </Scripts>
      </CheckButton>
      <EditBox name="$parentPreset1" inherits="UMMSettingsGoldPresetTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="178" y="347"/></Offset></Anchor></Anchors>
      </EditBox>
      <EditBox name="$parentPreset2" inherits="UMMSettingsGoldPresetTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="178" y="379"/></Offset></Anchor></Anchors>
      </EditBox>
      <Button name="$parentSavePresets" inherits="UIPanelButtonTemplate" text="">
        <Size><AbsDimension x="130" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="190" y="412"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_SavePresets();</OnClick></Scripts>
      </Button>
      <Button name="$parentCheck" inherits="UIPanelButtonTemplate" text="">
        <Size><AbsDimension x="120" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="478"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("check");</OnClick></Scripts>
      </Button>
      <Button name="$parentTrace" inherits="UIPanelButtonTemplate" text="">
        <Size><AbsDimension x="120" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="150" y="478"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("trace");</OnClick></Scripts>
      </Button>
      <Button name="$parentDefaults" inherits="UIPanelButtonTemplate" text="">
        <Size><AbsDimension x="120" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="508"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("defaults");</OnClick></Scripts>
      </Button>
      <Button name="$parentReset" inherits="UIPanelButtonTemplate" text="">
        <Size><AbsDimension x="120" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="150" y="508"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_Button("resetchars");</OnClick></Scripts>
      </Button>
      <Button name="$parentConfirmYes" inherits="UIPanelButtonTemplate" text="" hidden="true">
        <Size><AbsDimension x="120" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="508"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_ConfirmReset(true);</OnClick></Scripts>
      </Button>
      <Button name="$parentConfirmNo" inherits="UIPanelButtonTemplate" text="" hidden="true">
        <Size><AbsDimension x="120" y="24"/></Size>
        <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="150" y="508"/></Offset></Anchor></Anchors>
        <Scripts><OnClick>UMMSettingsUI_ConfirmReset(false);</OnClick></Scripts>
      </Button>
      <!-- Shown for one frame after a gold preset edit to put the commas back. -->
      <Frame name="$parentPresetFormat" hidden="true">
        <Size><AbsDimension x="0" y="0"/></Size>
        <Anchors><Anchor point="TOPLEFT"/></Anchors>
        <Scripts><OnUpdate>this:Hide(); UMMSettingsUI_FormatPresets();</OnUpdate></Scripts>
      </Frame>
    </Frames>
    <Scripts>
      <OnLoad>UMMSettingsUI_OnLoad(this);</OnLoad>
      <OnShow>UMMSettingsUI_Refresh(true);</OnShow>
      <OnHide>UMMSettingsUI_ConfirmReset(false);</OnHide>
    </Scripts>
  </Frame>
</Ui>
