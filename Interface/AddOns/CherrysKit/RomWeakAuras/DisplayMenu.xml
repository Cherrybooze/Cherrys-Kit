<Ui xmlns="http://www.runewaker.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/UI.xsd">
	<Frame name="RWA_DisplayAddMenu" parent="RWA_OptionsWindow" frameStrata="TOOLTIP" enableMouse="true" hidden="true">
		<Size><AbsDimension x="116" y="104" /></Size>
		<Anchors><Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER" /></Anchors>
		<Backdrop name="$parent_Backdrop" bgFile="Interface/Tooltips/Tooltip-Background" edgeFile="Interface/Tooltips/Tooltip-border">
			<EdgeSize><AbsValue val="8" /></EdgeSize>
			<TileSize><AbsValue val="16" /></TileSize>
			<BackgroundInsets><AbsInset top="2" left="2" bottom="2" right="2" /></BackgroundInsets>
		</Backdrop>
		<Frames>
			<Button name="RWA_DisplayAddText" inherits="UIPanelButtonTemplate" text="Text">
				<Size><AbsDimension x="100" y="22" /></Size>
				<Anchors><Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT"><Offset><AbsDimension x="8" y="5" /></Offset></Anchor></Anchors>
				<Scripts><OnClick>RWA.DisplayMenu.Choose("text");</OnClick></Scripts>
			</Button>
			<Button name="RWA_DisplayAddBar" inherits="UIPanelButtonTemplate" text="Bar">
					<Size><AbsDimension x="100" y="22" /></Size>
				<Anchors><Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT"><Offset><AbsDimension x="8" y="29" /></Offset></Anchor></Anchors>
				<Scripts><OnClick>RWA.DisplayMenu.Choose("aurabar");</OnClick></Scripts>
			</Button>
			<Button name="RWA_DisplayAddIcon" inherits="UIPanelButtonTemplate" text="Icon">
				<Size><AbsDimension x="100" y="22" /></Size>
				<Anchors><Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT"><Offset><AbsDimension x="8" y="53" /></Offset></Anchor></Anchors>
				<Scripts><OnClick>RWA.DisplayMenu.Choose("icon");</OnClick></Scripts>
			</Button>
			<Button name="RWA_DisplayAddGraphic" inherits="UIPanelButtonTemplate" text="Graphic">
				<Size><AbsDimension x="100" y="22" /></Size>
				<Anchors><Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT"><Offset><AbsDimension x="8" y="77" /></Offset></Anchor></Anchors>
				<Scripts><OnClick>RWA.DisplayMenu.Choose("texture");</OnClick></Scripts>
			</Button>
		</Frames>
		<Scripts><OnHide>if RWA.DisplayMenu and RWA.DisplayMenu.open then RWA.DisplayMenu.Close(); end</OnHide></Scripts>
	</Frame>
</Ui>
