<Ui xmlns="http://www.runewaker.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/UI.xsd">
	<!-- Cherry's Info: "Show all client buffs and debuffs" (AllBuffs.lua). 96 icons declared here, since RoM gives
	     frames made from Lua no scripts. The display frame is hidden while the setting is off, so it gets no OnUpdate. -->
	<Button name="CInfoBuffTemplate" virtual="true" enableMouse="true" hidden="true">
		<Size><AbsDimension x="30" y="30" /></Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBorder" file="Interface\Common\Bar\Smooth"><Size><AbsDimension x="30" y="30" /></Size><Anchors><Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER"><Offset><AbsDimension x="0" y="0" /></Offset></Anchor></Anchors></Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon"><Size><AbsDimension x="28" y="28" /></Size><Anchors><Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER"><Offset><AbsDimension x="0" y="0" /></Offset></Anchor></Anchors></Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="$parentCount" inherits="NumberFontNormal" justifyH="RIGHT" text=""><Anchors><Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="-1" y="-1" /></Offset></Anchor></Anchors></FontString>
				<FontString name="$parentTime" inherits="GameFontHighlight" justifyH="CENTER" text=""><FontHeight><AbsValue val="10" /></FontHeight><Anchors><Anchor point="TOP" relativeTo="$parent" relativePoint="BOTTOM"><Offset><AbsDimension x="0" y="1" /></Offset></Anchor></Anchors></FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>this:RegisterForClicks("LeftButton", "RightButton");</OnLoad>
			<OnClick>CherrysQuests.AllBuffs.Click(this:GetID(), key);</OnClick>
			<OnMouseDown>CherrysQuests.AllBuffs.MouseDown(key);</OnMouseDown>
			<OnMouseUp>CherrysQuests.AllBuffs.MouseUp(key);</OnMouseUp>
			<OnEnter>CherrysQuests.AllBuffs.Enter(this:GetID(), this);</OnEnter>
			<OnLeave>CherrysQuests.AllBuffs.Leave();</OnLeave>
		</Scripts>
	</Button>
