<Ui xmlns="http://www.runewaker.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/UI.xsd">
	<!-- PortraitHP: the event frame on the target portrait (scripts must be declared in XML in RoM). -->
	<Frame name="PortraitHP_Frame" parent="TargetPortrait" hidden="true">
		<Anchors>
			<Anchor point="CENTER" relativeTo="TargetPortrait" relativePoint="CENTER">
				<Offset><AbsDimension x="0" y="0"/></Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				PortraitHP.OnFrameLoad(this)
			</OnLoad>
			<OnEvent>
				PortraitHP.OnEvent(this, event, arg1, arg2)
			</OnEvent>
		</Scripts>
	</Frame>
</Ui>
