	<CheckButton name="CEMI_MacroFrameButtonTemplate" inherits="CEMI_MacroButtonTemplate" virtual="true">
		<Scripts>
			<OnEnter>CherrysEMI.MacroButton_OnEnter(this)</OnEnter>
			<OnLeave>GameTooltip:Hide()</OnLeave>
			<OnClick>CherrysEMI.MacroButton_OnClick(this)</OnClick>
			<OnDragStart>PickupMacroItem(this:GetID())</OnDragStart>
			<OnReceiveDrag>PickupMacroItem(this:GetID()) CherrysEMI.UpdateMacros()</OnReceiveDrag>
		</Scripts>
	</CheckButton>

