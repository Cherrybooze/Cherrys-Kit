                </Layers>
                <Scripts>
                    <OnEnter>
                        _G[this:GetParent():GetName().."Highlight"]:Show()
                    </OnEnter>
                    <OnLeave>
                        _G[this:GetParent():GetName().."Highlight"]:Hide()
                    </OnLeave>
                    <OnEscapePressed>
                        this:ClearFocus();
                    </OnEscapePressed>
                    <OnEnterPressed>
                        this:ClearFocus();
                    </OnEnterPressed>
                    <OnEditFocusLost>
                        this:Hide()
                        local moneyformatted = _G[this:GetParent():GetName().."MoneyFormatted"]
                        moneyformatted:Show()
