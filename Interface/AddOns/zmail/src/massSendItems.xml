    <Frame name="ZMailMassSendItemsTopTemplate" virtual="true">
        <Size>
            <AbsDimension x="290" y="26" />
        </Size>
        <Anchors>
            <Anchor point="TOPLEFT">
                <Offset>
                    <AbsDimension x="15" y="5" />
                </Offset>
            </Anchor>
            <Anchor point="TOPRIGHT">
                <Offset>
                    <AbsDimension x="-20" y="30" />
                </Offset>
            </Anchor>
        </Anchors>
        <Frames>
            <Button name="$parentRecipientButton" inherits="UIPanelButtonTemplate" text="> To">
                <Size>
                    <AbsDimension x="67" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT">
                        <Offset>
                            <AbsDimension x="-4" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local recipient = _G[this:GetParent():GetName().."Recipient"]
                        local function x(val) recipient:SetText(val) end 
                        zmail.ShowRecipientSelection(x, recipient:GetText())
                    </OnClick>
                </Scripts>
            </Button>
            <EditBox name="$parentRecipient" inherits="UIPanelEditBoxTemplate" historylines="0" letters="1024">
                <Size>
                    <AbsDimension x="180" y="25"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentRecipientButton">
                        <Offset>
                            <AbsDimension x="2" y="0" />
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnEscapePressed>
                        this:ClearFocus();
                    </OnEscapePressed>
                    <OnTextChanged>
                        zmail.massSendItems.check()
                    </OnTextChanged>
                </Scripts>
                <TextInsets>
                    <AbsInset top="4" left="4" bottom="0" right="4"/>
                </TextInsets>
                <FontString inherits="GameEditFont" spacing="1"/>
            </EditBox>
            <Button name="$parentReset" inherits="UIPanelButtonTemplate" text="> Reset">
                <Size>
                    <AbsDimension x="80" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentRecipient">
                        <Offset>
                            <AbsDimension x="3" y="0" />
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        zmail.massSendItems.reset()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentSend" inherits="UIPanelButtonTemplate" text="x: Send">
                <Size>
                    <AbsDimension x="70" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="RIGHT">
                        <Offset>
                            <AbsDimension x="0" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        zmail.massSendItems.send()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentCOD" inherits="UIPanelButtonTemplate" text="> COD">
                <Size>
                    <AbsDimension x="120" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="LEFT" relativeTo="$parentSend">
                        <Offset>
                            <AbsDimension x="-3" y="0" />
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local bags = ZMailFrameBodyMassSendItemsBags
                        local extra = ZMailFrameBodyMassSendItemsExtra
                        if bags:IsVisible() then
                            bags:Hide()
                            extra:Show()
                            this:SetText(GCF_TEXT_BAG)
                        else
                            extra:Hide()
                            bags:Show()
                            this:SetText(zmail.GetLocaString("CODButton"))
                        end
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>
