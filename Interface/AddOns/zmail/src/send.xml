                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>
                zmail.send.settings.OnCheckClick(this)
            </OnClick>
            <OnEnter>
                zmail.send.settings.OnCheckEnter(this)
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide()
