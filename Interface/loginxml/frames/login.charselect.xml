<Ui xmlns="http://www.runewaker.com/" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/
../WorldXml/UI.xsd">
  <Frame name="LoginCharSelectFrame" parent="LoginFrame" enableKeyboard="true" enableMouse="true" hidden="true" frameLevel="200">
    <Frames>
      <Frame name="$parent_chars" inherits="LOGIN_List_Frame_Template">
        <Size>
          <AbsDimension y="1" x="1"/>
        </Size>
        <Anchors>
          <Anchor point="RIGHT">
            <Offset>
              <AbsDimension x="-10" y="-20"/>
            </Offset>
          </Anchor>
        </Anchors>
      </Frame>
      <Frame name="$parent_channels" inherits="LOGIN_List_Frame_Template">
        <Size>
          <AbsDimension y="1" x="1"/>
        </Size>
        <Anchors>
          <Anchor point="BOTTOM" relativeTo="$parent_chars" relativePoint="TOP" />
        </Anchors>
      </Frame>
      <Button name="$parent_delete" inherits="LoginButtonTemplate" text="CHARACTER_SELECT_DELETE">
        <Anchors>
          <Anchor point="TOP" relativePoint="BOTTOM" relativeTo="$parent_chars"/>
        </Anchors>
        <Scripts>
          <OnClick>
						login.charselect.delete()
          </OnClick>
        </Scripts>
      </Button>
      <Button name="$parent_server" inherits="LoginButtonTemplate" text="CHARACTER_SELECT_REALM">
        <Anchors>
          <Anchor point="RIGHT" relativePoint="LEFT" relativeTo="LoginFrame_quit"/>
        </Anchors>
        <Scripts>
          <OnClick>
						login.GOTO("server")
          </OnClick>
        </Scripts>
      </Button>
      <Button name="$parent_account" inherits="LoginButtonTemplate" text="LOGIN_BACK">
        <Anchors>
          <Anchor point="RIGHT" relativePoint="LEFT" relativeTo="$parent_server"/>
        </Anchors>
        <Scripts>
          <OnClick>
						login.GOTO("account")
          </OnClick>
        </Scripts>
      </Button>
			<Button name="$parent_enter" inherits="LoginButtonTemplate" text="CHARACTER_ENTER_WORLD">
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-68"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						login.charselect.login();
					</OnClick>
				</Scripts>
			</Button>

      <Button name="CharacterSelectRotateRightButton">
				<Size>
					<AbsDimension x="28" y="28"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="86" y="-112"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
          <OnMouseDown>
            this:GetParent().rotate = "right"
          </OnMouseDown>
					<OnMouseUp>
            this:GetParent().rotate = nil
					</OnMouseUp>
				</Scripts>
				<NormalTexture file="Interface\Login\Common\RotationRight-Normal">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
				</NormalTexture>
				<PushedTexture file="Interface\Login\Common\RotationRight-Depress">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
				</PushedTexture>
				<HighlightTexture file="Interface\Buttons\PanelUpButton-Highlight" alphaMode="ADD"/>
			</Button>
			<Button name="CharacterSelectRotateLeftButton">
				<Size>
					<AbsDimension x="28" y="28"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="-86" y="-112"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
          <OnMouseDown>
            this:GetParent().rotate = "left"
          </OnMouseDown>
					<OnMouseUp>
            this:GetParent().rotate = nil
					</OnMouseUp>
				</Scripts>
				<NormalTexture file="Interface\Login\Common\RotationLeft-Normal">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
				</NormalTexture>
				<PushedTexture file="Interface\Login\Common\RotationLeft-Depress">
					<TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
				</PushedTexture>
				<HighlightTexture file="Interface\Buttons\PanelUpButton-Highlight" alphaMode="ADD"/>
			</Button>
    </Frames>
    <Scripts>
      <OnLoad>
        login.charselect.onLoad(this)
      </OnLoad>
      <OnShow>
        login.charselect.onShow(this)
      </OnShow>
      <OnHide>
        CloseCharacterSelect();
      </OnHide>
      <OnEscapePressed>
        login.GOTO("server")
      </OnEscapePressed>
			<OnMouseDown>
        this.cursor = GetCursorPos()
			</OnMouseDown>
			<OnMouseUp>
        this.cursor = nil
			</OnMouseUp>
			<OnUpdate>
				login.charselect.onUpdate(this, elapsedTime);
			</OnUpdate>
      <OnEnterPressed>
        login.charselect.login()
      </OnEnterPressed>
      <OnKeyDown>
        login.charselect.onKeyDown(key)
      </OnKeyDown>
    </Scripts>
  </Frame>
</Ui>
