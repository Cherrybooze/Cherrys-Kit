<Ui xmlns="http://www.runewaker.com/" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/
../WorldXml/UI.xsd">
  <Slider name="LoginBoneSliderTemplate" virtual="true" inherits="LoginSliderTemplate">
    <Layers>
      <Layer>
        <FontString name="$parent_name" inherits="LoginFontHighlightSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="BOTTOM" relativePoint="TOP">
              <Offset>
                <AbsDimension x="0" y="0"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
						this:SetValueStepMode("FLOAT");
            this.part = string.match(this:GetName(), "_([^_]+)$")
            this.text = TEXT("LOGIN_"..string.upper(this.part)).." (%0.2f)"
      </OnLoad>
      <OnValueChanged>
            _G[this:GetName().."_name"]:SetText(string.format(this.text, this:GetValue()))
            login.charcreate.updateBoneScale()
      </OnValueChanged>
      <OnMouseWheel>
          local val = delta>0 and 1 or -1
          local span = this:GetMaxValue() - this:GetMinValue()
          if IsShiftKeyDown() then
            val = val*span/100*5
          elseif IsAltKeyDown() then
            val = val*span/100*10
          elseif IsCtrlKeyDown() then
                val = val*span/100*20
            else
                val = val * span / 100
          end
          this:SetValue(this:GetValue() - val)
      </OnMouseWheel>
    </Scripts>
  </Slider>
  <Slider name="LoginModelSliderTemplate" virtual="true" inherits="LoginSliderTemplate">
    <Layers>
      <Layer>
        <FontString name="$parent_name" inherits="LoginFontHighlightSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="BOTTOM" relativePoint="TOP">
              <Offset>
                <AbsDimension x="0" y="0"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        local tbl = {
          skin = "LOGIN_SKIN_COLOR",
          hair = "LOGIN_HAIR_STYLE",
          face = "LOGIN_FACE",
        }
						this:SetValueStepMode("INT");
            this.part = string.match(this:GetName(), "_([^_]+)$")
            this.text = TEXT(tbl[this.part]).." (%d)"
      </OnLoad>
      <OnValueChanged>
        _G[this:GetName().."_name"]:SetText(string.format(this.text, this:GetValue()))
        login.charcreate.updateModel({[this.part]=this:GetValue()})
      </OnValueChanged>
      <OnMouseWheel>
          local val = delta>0 and 1 or -1
          this:SetValue(this:GetValue() - val)
      </OnMouseWheel>
    </Scripts>
  </Slider>
  <Frame name="LoginBGFrameTemplate" virtual="true">
    <Backdrop edgeFile="Interface\Tooltips\Tooltip-border" bgFile="Interface\SocialFrame\SocialFrame_Contextborder_bg">
      <EdgeSize>
        <AbsValue val="10"/>
      </EdgeSize>
      <TileSize>
        <AbsValue val="5"/>
      </TileSize>
    </Backdrop>
    <Scripts>
      <OnLoad>
        this:SetBackdropTileAlpha(.4)
      </OnLoad>
    </Scripts>
  </Frame>
  <EditBox name="LoginHairColorEditTemplate" virtual="true" inherits="LoginPanelEditBoxTemplate" letters="3" numeric="true">
    <Size>
      <AbsDimension x="40" y="20"/>
    </Size>
    <Scripts>
      <OnLoad>
          this.color = string.match(this:GetName(), "_([^_]+)$")
      </OnLoad>
      <OnTextChanged>
        login.charcreate.updateHairColor()
      </OnTextChanged>
      <OnMouseWheel>
          local val = delta>0 and -1 or 1
          local num = tonumber(this:GetText()) or 0
          this:SetText(math.min(255, math.max(0, num - val)))
      </OnMouseWheel>
    </Scripts>
  </EditBox>
  <Frame name="LoginCharCreateFrame" parent="LoginFrame" enableKeyboard="true" enableMouse="true" hidden="true" frameLevel="200">
    <Frames>
      <Frame name="$parent_left" inherits="LoginBGFrameTemplate">
        <Size>
          <AbsDimension x="1" y="1"/>
        </Size>
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="10" y="100"/>
            </Offset>
          </Anchor>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT">
            <Offset>
              <AbsDimension x="250" y="-100"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Frames>
          <EditBox name="$parent_hair_g" inherits="LoginHairColorEditTemplate">
            <Anchors>
              <Anchor point="TOP">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </EditBox>
          <EditBox name="$parent_hair_r" inherits="LoginHairColorEditTemplate">
            <Size>
              <AbsDimension x="40" y="20"/>
            </Size>
            <Anchors>
              <Anchor point="RIGHT" relativeTo="$parent_hair_g" relativePoint="LEFT"/>
            </Anchors>
          </EditBox>
          <EditBox name="$parent_hair_b" inherits="LoginHairColorEditTemplate">
            <Anchors>
              <Anchor point="LEFT" relativeTo="$parent_hair_g" relativePoint="RIGHT"/>
            </Anchors>
          </EditBox>
          <Frame name="$parent_hair_color" enableMouse="true">
              <Layers>
							<Layer level="BACKGROUND">
                  <Texture name="$parentTexture" file="Interface\Login\Common\ColorButton-Background"/>
                </Layer>
              </Layers>
								<Size>
									<AbsDimension x="18" y="18"/>
								</Size>
              <Anchors>
                <Anchor point="LEFT" relativeTo="$parent_hair_b" relativePoint="RIGHT">
                  <Offset>
                    <AbsDimension x="2" y="0"/>
                  </Offset>
                </Anchor>
              </Anchors>
              <Scripts>
                <OnClick>
										local r, g, b = _G[this:GetName().."Texture"]:GetColor();
										local info = {};
										info.r = r;
										info.g = g;
										info.b = b;
										info.a = a;
										info.brightnessUp = 1;
										info.brightnessDown = 0.238;
										info.callbackFuncOkay = login.charcreate.colorpickerCallback;
										info.callbackFuncUpdate = login.charcreate.colorpickerCallback;
										info.callbackFuncCancel = login.charcreate.colorpickerCallback;
										OpenLoginColorPickerFrame(info);
                </OnClick>
              </Scripts>
          </Frame>
  
          <Slider name="$parent_skin" frameLevel="2" inherits="LoginModelSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_hair_g" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_hair" frameLevel="2" inherits="LoginModelSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_skin" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_face" frameLevel="2" inherits="LoginModelSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_hair" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>

          <Button name="$parent_zoom" inherits="LoginButtonTemplate" text="b1">
            <Size>
              <AbsDimension x="80" y="20"/>
            </Size>
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_face" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="5"/>
                </Offset>
              </Anchor>
            </Anchors>
            <Scripts>
              <OnClick>
                login.charcreate.zoom()
              </OnClick>
            </Scripts>
          </Button>

          <Slider name="$parent_Head" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_zoom" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Breasts" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_Head" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Stature" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_Breasts" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Chest" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_Stature" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Figure" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_Chest" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Arm" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_Figure" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Forearm" frameLevel="2" inherits="LoginBoneSliderTemplate">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_Arm" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Hand" frameLevel="2" inherits="LoginBoneSliderTemplate">
