        <Frames>
          <EditBox name="$parent_name" inherits="LoginPanelEditBoxTemplate" letters="16">
            <Size>
              <AbsDimension x="160" y="25"/>
            </Size>
            <Anchors>
              <Anchor point="TOP">
                <Offset>
                  <AbsDimension x="0" y="20"/>
                </Offset>
              </Anchor>
            </Anchors>
            <Scripts>
              <OnLoad>
                  LoginEditBox_OnLoad(this)
                  this:SetPlaceholder(LOGIN_PLAYER_NAME)
              </OnLoad>
              <OnShow>
                  this:SetText("");
              </OnShow>
              <OnEnter>
								LoginTooltip:ClearAllAnchors();
								LoginTooltip:SetAnchor("TOPRIGHT", "BOTTOMLEFT", this, 0, 0);
                LoginTooltip:SetText(LOGIN_PLAYER_NAME)
                LoginTooltip:AddLine(CHARACTER_CREATE_NAME_TIP)
              </OnEnter>
              <OnLeave>
                LoginTooltip:Hide()
              </OnLeave>
            </Scripts>
          </EditBox>
          <Button name="$parent_namegen">
            <Size>
              <AbsDimension x="20" y="20"/>
            </Size>
            <Anchors>
              <Anchor point="LEFT" relativeTo="$parent_name" relativePoint="RIGHT"/>
            </Anchors>
          <NormalTexture file="Interface\gambleframe\gamble-run-normal"/>
          <PushedTexture file="Interface\gambleframe\gamble-run-depress"/>
          <HighlightTexture file="Interface\gambleframe\gamble-button-hilight" alphaMode="ADD"/>
            <Scripts>
              <OnClick>
                local name = login.charcreate.generateName()
                _G[this:GetParent():GetName().."_name"]:SetText(name)
