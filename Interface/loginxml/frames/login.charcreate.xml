              <Anchor point="TOP" relativeTo="$parent_Hand" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="18"/>
                </Offset>
              </Anchor>
            </Anchors>
          </Slider>
          <Slider name="$parent_Calf" frameLevel="2" inherits="LoginBoneSliderTemplate">
