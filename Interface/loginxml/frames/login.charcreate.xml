          <Button name="$parent_create" inherits="LoginButtonTemplate" text="LOGIN_OKAY">
            <Anchors>
              <Anchor point="TOP" relativeTo="$parent_class" relativePoint="BOTTOM">
                <Offset>
                  <AbsDimension x="0" y="10"/>
                </Offset>
              </Anchor>
            </Anchors>
            <Scripts>
              <OnClick>
                login.charcreate.create()
              </OnClick>
            </Scripts>
          </Button>
        </Frames>
      </Frame>
      <Button name="$parent_RotateRightButton">
        <Size>
          <AbsDimension x="28" y="28"/>
        </Size>
        <Anchors>
          <Anchor point="BOTTOM">
            <Offset>
              <AbsDimension x="86" y="-112"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnMouseDown>
            this:GetParent().rotate = "right"
          </OnMouseDown>
          <OnMouseUp>
            this:GetParent().rotate = nil
          </OnMouseUp>
        </Scripts>
        <NormalTexture file="Interface\Login\Common\RotationRight-Normal">
          <TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
        </NormalTexture>
        <PushedTexture file="Interface\Login\Common\RotationRight-Depress">
          <TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
        </PushedTexture>
        <HighlightTexture file="Interface\Buttons\PanelUpButton-Highlight" alphaMode="ADD"/>
      </Button>
      <Button name="$parent_RotateLeftButton">
        <Size>
          <AbsDimension x="28" y="28"/>
        </Size>
        <Anchors>
          <Anchor point="BOTTOM">
            <Offset>
              <AbsDimension x="-86" y="-112"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnMouseDown>
            this:GetParent().rotate = "left"
          </OnMouseDown>
          <OnMouseUp>
            this:GetParent().rotate = nil
          </OnMouseUp>
        </Scripts>
        <NormalTexture file="Interface\Login\Common\RotationLeft-Normal">
          <TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
        </NormalTexture>
        <PushedTexture file="Interface\Login\Common\RotationLeft-Depress">
          <TexCoords left="0" right="0.6875" top="0" bottom="0.6875"/>
        </PushedTexture>
        <HighlightTexture file="Interface\Buttons\PanelUpButton-Highlight" alphaMode="ADD"/>
      </Button>
      <Button name="$parent_charselect" inherits="LoginButtonTemplate" text="LOGIN_BACK">
        <Anchors>
          <Anchor point="RIGHT" relativePoint="LEFT" relativeTo="LoginFrame_quit"/>
        </Anchors>
        <Scripts>
          <OnClick>
						login.GOTO("charselect")
          </OnClick>
        </Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>
        login.charcreate.onLoad(this)
      </OnLoad>
      <OnShow>
        login.charcreate.onShow(this)
      </OnShow>
      <OnHide>
        CloseCharacterCreateModel()
      </OnHide>
      <OnEscapePressed>
        login.GOTO("charselect")
      </OnEscapePressed>
      <OnMouseDown>
        this.cursor = GetCursorPos()
      </OnMouseDown>
      <OnMouseUp>
        this.cursor = nil
      </OnMouseUp>
      <OnUpdate>
				login.charcreate.onUpdate(this, elapsedTime);
      </OnUpdate>
    </Scripts>
  </Frame>
</Ui>
