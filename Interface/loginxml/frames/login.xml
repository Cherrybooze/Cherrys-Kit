<Ui xmlns="http://www.runewaker.com/" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/
../WorldXml/UI.xsd">
  <Frame name="LoginParent"/>
  <Frame name="LoginFrame" parent="LoginParent">
    <Layers>
      <Layer level="HIGHLIGHT">
        <FontString name="LoginVersion" inherits="LoginFontNormal" justifyH="RIGHT">
          <Anchors>
            <Anchor point="TOPRIGHT">
              <Offset>
                <AbsDimension x="-10" y="2"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
        <FontString name="LoginAccount" inherits="LoginFontNormal" justifyH="RIGHT" hidden="true">
          <Anchors>
            <Anchor point="TOPRIGHT">
              <Offset>
                <AbsDimension x="-10" y="20"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parent_debug" inherits="LoginButtonTemplate" text="DEBUG" frameLevel="999">
        <Anchors>
          <Anchor point="BOTTOMLEFT">
            <Offset>
              <AbsDimension x="6" y="-30"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
							if LoginDebugFrame:IsVisible() then
                LoginDebugFrame:Hide()
              else
                LoginDebugFrame:Show()
              end
          </OnClick>
        </Scripts>
      </Button>
      <Button name="$parent_quit" inherits="LoginButtonTemplate" text="LOGIN_ACCOUNT_EXIT" frameLevel="999">
        <Anchors>
          <Anchor point="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="-6" y="-30"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
								QuitGame();
          </OnClick>
        </Scripts>
      </Button>
      <Button name="$parent_settings" inherits="LoginButtonTemplate" text="LOGIN_ACCOUNT_SYS" frameLevel="700">
        <Anchors>
          <Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parent_quit">
            <Offset>
              <AbsDimension x="0" y="-5"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
							if LoginSettingsFrame:IsVisible() then
                LoginSettingsFrame:Hide()
              else
                LoginSettingsFrame:Show()
              end
          </OnClick>
        </Scripts>
      </Button>
      <GameTooltip name="LoginTooltip" parent="LoginFrame" frameStrata="TOOLTIP" hidden="true" frameLevel="1000">
        <Backdrop edgeFile="Interface\Tooltips\Tooltip-border" bgFile="Interface\Tooltips\Tooltip-Background">
          <BackgroundInsets>
            <AbsInset top="4" left="4" bottom="4" right="4"/>
          </BackgroundInsets>
          <EdgeSize>
            <AbsValue val="16"/>
          </EdgeSize>
          <TileSize>
            <AbsValue val="16"/>
          </TileSize>
        </Backdrop>
        <Layers>
          <Layer level="ARTWORK">
            <FontString name="$parentTextLeft1" inherits="LoginFontNormal" hidden="true">
              <Anchors>
                <Anchor point="TOPLEFT">
                  <Offset>
                    <AbsDimension x="10" y="10"/>
                  </Offset>
                </Anchor>
              </Anchors>
            </FontString>
            <FontString name="$parentTextLeft2" inherits="LoginFontNormal" hidden="true">
              <Anchors>
                <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT">
                  <Offset>
