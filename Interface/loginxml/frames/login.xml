                  </Offset>
                </Anchor>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
      </GameTooltip>
    </Frames>
    <Scripts>
      <OnLoad>
        login.onLoad(this)
        LoginVersion:SetText(string.format("%s (%s %s)", GetVersion(), login.name, login.version))
        if not login.config.debug then
          LoginFrame_debug:Hide()
        end
      </OnLoad>
      <OnEvent>
        login.onEvent(event)
      </OnEvent>
    </Scripts>
  </Frame>
</Ui>