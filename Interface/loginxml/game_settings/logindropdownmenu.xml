					</Anchors>
					<TexCoords left="0.25" right="0.75" top="0" bottom="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentButton">
				<Size>
					<AbsDimension x="22" y="22"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT"/>
